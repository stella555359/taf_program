parameters:
  image: Image-0.190.710
  ssh_public_key: "ssh-rsa "
  vnf_name: sg03-tl911
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: mmW-SG03-laas11_db
    uvm: mmW-SG03-laas11_uvm
    oam: mmW-SG03-laas11_oam
    cpcl: mmW-SG03-laas11_cpcl
    cpif: mmW-SG03-laas11_cpif
    cpnrt: mmW-SG03-laas11_cpnrt
    cpnb: mmW-SG03-laas11_cpnb
    cpue: mmW-SG03-laas11_cpue
    upue: mmW-SG03-laas11_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: $5$rounds=10000$lgSVGprx$BqAt4JD1XJCUBFy7NM4lbjzfns4iS09lM37.8ldaWzC
    root: $5$rounds=10000$lgSVGprx$BqAt4JD1XJCUBFy7NM4lbjzfns4iS09lM37.8ldaWzC
  timezone: Asia/Shanghai
  uvm_image: Image-0.190.710
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: public-oam_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.11]
    f1m:
      uuid: public-fronthaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.90]
      fixed_v6_ips: []
    f1c:
      uuid: public-fronthaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.91]
      fixed_v6_ips: []
    x2c:
      uuid: public-backhaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.146]
      fixed_v6_ips: []
    s1c:
      uuid: public-backhaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.146]
      fixed_v6_ips: []
    f1u:
      uuid: public-fronthaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.92]
      fixed_v6_ips: []
    x2u:
      uuid: public-backhaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.147]
      fixed_v6_ips: []
    s1u:
      uuid: public-backhaul_ext_net-v46
      fixed_ips: [ip_address: 10.110.176.147]
      fixed_v6_ips: []
    tracing:
      uuid: public-tracing_int_net-v4

  internal_provider_networks: provider0
  internal_e1_provider_networks: provider0
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
