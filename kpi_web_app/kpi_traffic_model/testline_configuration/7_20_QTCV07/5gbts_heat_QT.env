resource_registry:
  RCP::Common::Parameters: modules/5gbts_common_params.yaml
parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: cv07-5gbts
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 135.117.48.1 ]
  flavors:
    db: 5gbts19_db
    sn: 5gbts19_sn
    uvm: 5gbts19_uvm
    oam: 5gbts19_oam
    cpcl: 5gbts19_cpcl
    cpif: 5gbts19_cpif
    cpnrt: 5gbts19_cpnrt
    cpnb: 5gbts19_cpnb
    cpue: 5gbts19_cpue
    upue: 5gbts19_upue
  ntp_servers: 135.117.48.1
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Europe/Paris
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: CV07-5gbts-oam_net-v4
      fixed_ips: [ip_address: 10.14.48.7]
    f1m:
      uuid: CV07-5gbts-fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.2.111]
    f1c:
      uuid: CV07-5gbts-fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.2.112]
    x2c:
      uuid: CV07-5gbts-backhaul_net-v4
      fixed_ips: [ip_address: 10.200.0.115]
    s1c:
      uuid: CV07-5gbts-backhaul_net-v4
      fixed_ips: []
    f1u:
      uuid: CV07-5gbts-fronthaul_net-v4
      fixed_ips: []
    x2u:
      uuid: CV07-5gbts-backhaul_net-v4
      fixed_ips: [ip_address: 10.200.0.116]
    s1u:
      uuid: CV07-5gbts-backhaul_net-v4
      fixed_ips: [ip_address: 10.200.0.116]
    tracing:
      uuid: CV07-5gbts-tracing_net-v4

  internal_provider_networks: physnet3
  internal_e1_provider_networks: physnet3
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
