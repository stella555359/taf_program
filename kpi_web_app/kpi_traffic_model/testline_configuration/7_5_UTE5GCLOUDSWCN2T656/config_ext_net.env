parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: tl655-5gbts
    dns_forwarders: 192.168.125.1
    networks:
      - name: oam
        cidr: 192.168.125.0/23
        gateway: 192.168.125.1
        start: 192.168.125.2
        end: 192.168.125.254
        net_type: vlan
        sid: 1699
        ip_ver: 4
        provider: provider0
      - name: fronthaul
        cidr: 10.0.3.0/24
        gateway: 10.0.3.200
        start: 10.0.3.1
        end: 10.0.3.100
        ip_ver: 4
        cidr_v6: fc00::10:0:3:0/112
        gateway_v6: fc00::10:0:3:200
        start_v6:  ffc00::10:0:3:1
        end_v6:  ffc00::10:0:3:100
        ip_v6_ver: 6
        net_type: vlan
        sid: 1674
        provider: provider0
      - name: backhaul
        cidr: 10.0.1.0/24
        gateway: 10.0.1.200
        start: 10.0.1.1
        end: 10.0.1.100
        ip_ver: 4
        cidr_v6: fc00::10:0:1:0/112
        gateway_v6: fc00::10:0:1:200
        start_v6: fc00::10:0:1:1
        end_v6: fc00::10:0:1:100
        ip_v6_ver: 6
        net_type: vlan
        sid: 1698
        provider: provider0
      - name: tracing
        cidr: 10.0.4.0/24
        gateway: 10.0.4.1
        start: 10.0.4.100
        end: 10.0.4.200
        net_type: vlan
        sid: 1676
        ip_ver: 4
        provider: provider0


