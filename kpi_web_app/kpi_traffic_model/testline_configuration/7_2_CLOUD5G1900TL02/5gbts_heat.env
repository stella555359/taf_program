parameters:
  image: TL02_5gbts_rac
  ssh_public_key: "ssh-rsa "
  vnf_name: c1900t02
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.171.0.1 ]
  flavors:
    db: C1900T02_db
    sn: C1900T02_sn
    uvm: C1900T02_uvm
    oam: C1900T02_oam
    cpcl: C1900T02_cpcl
    cpif: C1900T02_cpif
    cpnrt: C1900T02_cpnrt
    cpnb: C1900T02_cpnb
    cpue: C1900T02_cpue
    upue: C1900T02_upue
  ntp_servers: 10.171.8.4
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Asia/Kolkata
  uvm_image: TL02_5gbts_rac
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: C1900T02-oam_T02_net-v4
      fixed_ips: [ip_address: 192.168.125.10]
    f1m:
      uuid: C1900T02-fronthaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.2.111]
    f1c:
      uuid: C1900T02-fronthaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.2.112]
      fixed_ips_0: [ ip_address: 192.168.2.113 ]
      fixed_ips_1: [ ip_address: 192.168.2.114 ]
    x2c:
      uuid: C1900T02-backhaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.4.111]
    s1c:
      uuid: C1900T02-backhaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.4.111]
    f1u:
      uuid: C1900T02-fronthaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.2.113]
    x2u:
      uuid: C1900T02-backhaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.4.112]
    s1u:
      uuid: C1900T02-backhaul_T02_net-v4
      fixed_ips: [ip_address: 192.168.4.113]
    tracing:
      uuid: C1900T02-backhaul_T02_net-v4

  internal_provider_networks: c1900_T02_net2
  internal_e1_provider_networks: c1900_T02_net2
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'

