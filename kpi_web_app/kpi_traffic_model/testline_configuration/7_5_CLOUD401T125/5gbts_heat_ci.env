parameters:
  image: Image-6.1151.484
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: sq7-TL125
  cluster_id: '03'
  vnfc_type_name_case: upper
  flavors:
    oam: sq7-tl125_oam
    cpcn: sq7-tl125_cpcn
    cpcl: sq7-tl125_cpcl
    cpif: sq7-tl125_cpif
    cpnb: sq7-tl125_cpnb
    cpnrt: sq7-tl125_cpnrt
    cpue: sq7-tl125_cpue
    upue: sq7-tl125_upue
    uvm: sq7-tl125_uvm
    db: sq7-tl125_db
  timezone: Asia/Shanghai
  oam_network: oam
  oam_ip: 10.57.171.10
  oam_default_gw: 10.57.171.1
  ntp_servers: 10.56.126.22
  dns_forwarders: [ 10.56.126.31 ]

  internal_network: sq7-tl125-internal_net-v4
  internal_srv_network: sq7-tl125-internal_srv_net-v4
  internal_e1_network: sq7-tl125-internal_e1_net-v4

  internal_networks:
    internal: [ 192.168.11.0/24, 192.168.11.2, 192.168.11.165 ]
    internal_srv: [ 192.168.13.0/24, 192.168.13.2, 192.168.13.165 ]
    internal_e1: [ 192.168.15.0/24, 192.168.15.2, 192.168.15.165 ]

  external_networks:
    extnet_a: example-5gbts-extnet-a_net-v4
    extnet_b: example-5gbts-extnet-b_net-v4
  ext_port:

    f1om_sid_a: 1231
    fronthaul_cpif_sid_a: 1232
    fronthaul_upue_sid_a: 1232
    backhaul_cpif_sid_a: 1233
    backhaul_upue_sid_a: 1233

    f1om_sid_b: 1234
    fronthaul_cpif_sid_b:  1235
    fronthaul_upue_sid_b:  1235
    backhaul_cpif_sid_b: 1236
    backhaul_upue_sid_b: 1236

    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '192.10.135.11/32' ]  
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '192.10.135.12/32' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '192.10.134.13/32' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '192.10.134.14/32' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '192.10.133.15/32' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '192.10.133.16/32' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [ '192.10.132.17/32' ]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [ '192.10.131.18/32' ]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '192.10.130.19/32' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '192.10.36.37/32' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: ['192.10.16.16/32']
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [ '192.10.36.36/32' ]
    backhaul_role_cpif: 'X2-C'
    backhaul_ip_cpif: [ '192.10.17.17/32' ]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [ '192.10.37.37/32' ]

    f1om_ip_oam_a: [ '192.10.6.6/24' ]
    f1om_ip_cpcl_a_0: [ '192.10.6.8/24' ]
    f1om_ip_cpcl_a_1: [ '192.10.6.18/24' ]
    f1om_ip_cpnb_a_0: [ '192.10.6.7/24' ]
    f1om_ip_cpnb_a_1: [ '192.10.6.17/24' ]
    f1om_ip_cpif_a_0: [ '192.10.6.4/24' ]
    f1om_ip_cpif_a_1: [ '192.10.6.14/24' ]
    f1om_ip_upue_a: [ '192.10.6.5/24' ]
    f1om_ip_cpue_a: [ '192.10.6.9/24' ]
    f1om_ip_cpnrt_a: [ '192.10.6.13/24' ]

    fronthaul_ip_cpif_a: [ '192.10.2.4/24' ]
    fronthaul_ip_upue_a: [ '192.10.2.5/24' ]
    backhaul_ip_cpif_a: [ '192.10.4.4/24' ]
    backhaul_ip_upue_a: [ '192.10.4.5/24' ]

    f1om_ip_oam_b: [ '192.10.9.6/24' ]
    f1om_ip_cpcl_b_0: [ '192.10.9.8/24' ]
    f1om_ip_cpcl_b_1: [ '192.10.9.18/24' ]
    f1om_ip_cpnb_b_0: [ '192.10.9.7/24' ]
    f1om_ip_cpnb_b_1: [ '192.10.9.17/24' ]
    f1om_ip_cpif_b_0: [ '192.10.9.4/24' ]
    f1om_ip_cpif_b_1: [ '192.10.9.14/24' ]
    f1om_ip_upue_b: [ '192.10.9.5/24' ]
    f1om_ip_cpue_b: [ '192.10.9.9/24' ]
    f1om_ip_cpnrt_b: [ '192.10.9.10/24' ]

    fronthaul_ip_cpif_b: [ '192.10.7.4/24' ]
    fronthaul_ip_upue_b: [ '192.10.7.5/24' ]
    backhaul_ip_cpif_b: [ '192.10.8.4/24' ]
    backhaul_ip_upue_b: [ '192.10.8.5/24' ]

  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1400
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1400
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_0: nova
    cpcl_0: nova
    cpcl_1: nova
    cpnb_0: nova
    cpnb_1: nova
    cpif_0: nova
    cpif_1: nova
    cpnrt_0: nova
    db_0: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
        - nova
        - nova
  oam_security_group:
  number_of_upue_nodes: 1
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
