parameters:
  image: 7.1106.485
  ssh_public_key: "ssh-rsa "
  vnf_name: tl723
  cluster_id: "1"
  dns_forwarders: [ 135.117.48.1 ]
  dual_stack: disabled
  flavors:
    db: tl723_db
    uvm: tl723_uvm
    oam: tl723_oam
    cpcl: tl723_cpcl
    cpif: tl723_cpif
    cpnrt: tl723_cpnrt
    cpnb: tl723_cpnb
    cpue: tl723_cpue
    upue: tl723_upue
  ntp_servers: 135.117.48.1
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  timezone: Europe/Paris
  uvm_image: 7.1106.485
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.6.0/24, 192.168.6.2, 192.168.6.165 ]
  external_networks:
    oam:
      uuid: 3946fb45-1951-4dab-a4c2-2e55cdd1d9d1
      fixed_ips: [ip_address: 10.14.48.56 ]
    f1m:
      uuid: d9102c9c-bf54-4fc9-a7fc-17a5c76298a2
      fixed_ips: []
      fixed_v6_ips: []
    f1c:
      uuid: d9102c9c-bf54-4fc9-a7fc-17a5c76298a2
      fixed_ips: []
      fixed_v6_ips: []
    x2c:
      uuid: ee57cc75-58cd-44c2-9b2f-3ada7cd2c859
      fixed_ips: [ip_address: 10.0.102.145]
      fixed_v6_ips: []
    s1c:
      uuid: ee57cc75-58cd-44c2-9b2f-3ada7cd2c859
      fixed_ips: [ip_address: 10.0.102.145]
      fixed_v6_ips: []
    f1u:
      uuid: d9102c9c-bf54-4fc9-a7fc-17a5c76298a2
      fixed_ips: []
      fixed_v6_ips: []
    x2u:
      uuid: ee57cc75-58cd-44c2-9b2f-3ada7cd2c859
      fixed_ips: []
      fixed_v6_ips: []
    s1u:
      uuid: ee57cc75-58cd-44c2-9b2f-3ada7cd2c859
      fixed_ips: [ip_address: 10.0.102.146]
      fixed_v6_ips: []
    tracing:
      uuid: 3f4d13f8-5ab0-4c12-b930-8a825ba5433d

  internal_provider_networks: physnet3
  internal_e1_provider_networks: physnet3
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0777'
