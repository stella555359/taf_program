parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: tl723
    dns_forwarders: 135.117.48.1
    networks:
      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.48.56
        end: 10.14.48.56
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1
      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.110
        end: 192.168.2.120
        ip_ver: 4
        #cidr_v6: fc00::192:168:2:0/112
        #gateway_v6: fc00::192:168:2:1
        #start_v6:  fc00::192:168:2:100
        #end_v6:  fc00::192:168:2:200
        #ip_v6_ver: 6
        net_type: vlan
        sid: 1100
        provider: physnet3
      - name: backhaul
        cidr: 10.0.102.0/23
        gateway: 10.0.102.150
        start: 10.0.102.145
        end: 10.0.102.146
        ip_ver: 4
        #cidr_v6: fc00::172:16:2:0/112
        #gateway_v6: fc00::172:16:2:1
        #start_v6: fc00::172:16:2:100
        #end_v6: fc00::172:16:2:200
        #ip_v6_ver: 6
        net_type: vlan
        sid: 4002
        provider: physnet1
      - name: tracing
        cidr: 172.16.4.0/24
        gateway: 172.16.4.1
        start: 172.16.4.100
        end: 172.16.4.200
        net_type: vlan
        sid: 4090
        ip_ver: 4
        provider: physnet1

