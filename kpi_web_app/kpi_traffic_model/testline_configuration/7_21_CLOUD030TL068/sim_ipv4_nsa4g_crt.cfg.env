#1rameter should be match the value in ./edaemon --port <DAEMON_PORT>
set DAEMON_PORT=10000

# FZM
set ASIRLTE="172.31.1.113"

set S1_ADDR="172.31.1.111:36412"
set S1U_ADDR="172.31.1.111:2152"
set S11_ADDR="172.31.1.111:2153"


#PGW addresses and UE IPs should belong to the same subnet

## PGW FOR GENTEK 
set PGW_ADDR_1="27.168.1.200/24"

set_enb id=1 plmn=460:06 s1=$ASIRLTE enb_id_macro=0x0032B daemon=:$DAEMON_PORT
set_cell id=1 enb=1 tac=1 eci=0x0032B01 pci=46:0


#configuring EPC
set_mme id=1 ip=:$DAEMON_PORT s1=$S1_ADDR mmegi=1 mmec=3

mme_param id=1 t3412=11160
set_sgw id=1 ip=:$DAEMON_PORT s1u=$S1U_ADDR s11=$S11_ADDR 

set_pgw id=1 ip=:$DAEMON_PORT apn=ims devtype=tun devname=tunPGW1 addr=$PGW_ADDR_1 

#Configuring UEs

#### GEMTEK UE ########

set_ue external id=1 sec_key=11111111111111111111111111111111 opc_key=11111111111111111111111111111111 imsi=460:06:4100000022 eia=snow3g+aes+zuc eea=snow3g+aes+zuc
set_bearer id=1 ue=1 trf_type=external default=on qci=9 priority=8 preemption=on vulnerability=on ip=27.168.1.10 

#set_ue external id=2 sec_key=11111111111111111111111111111111 opc_key=11111111111111111111111111111111 imsi=460:06:3000000963 eia=snow3g+aes+zuc eea=snow3g+aes+zuc
#set_bearer id=1 ue=2 trf_type=external default=on qci=9 priority=8 preemption=on vulnerability=on ip=27.168.1.11

#Turning on the information only about errors--for high perfomance
debug_log level=3 dir=logs
#set_log log_to_file=on
#pgw_lmts_param bearer_activation_by_trf=on


#trace protocol=nas mme=1 on
#trace protocol=all action=on sgw=1 mme=1
#trace protocol=nas uec=1 action=on
#trace protocol=rrc uec=1 action=on
#trace protocol=all uec=1 mme=1 
#trace protocol=nas mme=1 on
#trace protocol=s1 mme=1 on

cfg_end

