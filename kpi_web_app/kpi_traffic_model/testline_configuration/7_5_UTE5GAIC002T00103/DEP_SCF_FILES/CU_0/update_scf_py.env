"""
When you do a PNP deployment with NetAct, there's a validation for SCF parameter value.
If NetAct prompt `unsupported parameter values in classes`,
you can check parameter value range from https://mind.emea.nsn-net.net/,
try to use GUI default value if not sure.
"""
import sys
import os.path
from lxml import etree as ET
from difflib import get_close_matches
# Hangzhou CMP server
CMP_SERVER_IP = "10.97.120.186"
CA_SUBJECT_NAME = "DC=cmp, O=nokia, OU=ivtrans, CN=IPsecbackup"
# # Espoo CMP server
# CMP_SERVER_IP = "10.27.175.216"
# CA_SUBJECT_NAME = "C=FI, O=NSN, CN=EspooRootCA"
# # Bangalore New CMP server
# CMP_SERVER_IP = "10.96.129.254"
# CA_SUBJECT_NAME = "CN=srnblrna1"

XMLNS = "raml21.xsd"


def adapt_scf_to_pnp(scf_file,
                     system_release,  # it looks even wrong value doesn't make affect
                     sw_version,
                     output_file,
                     cmp_server=CMP_SERVER_IP,
                     cmp_ca_subject=CA_SUBJECT_NAME,
                     integrate_ver="INT_01"):
    """
    This function will adapt invalid parameters in original SCF file to meet PNP requirements.
    The output SCF can be appended to manual CNF plan in XML format, but currently the keyword
    "Create PNP VDU SCF Plan For Netact" only takes managedObject element in pure text format,
    then you need to delete header and tail of the XML file manually.

    :param string scf_file: the original VDU scf file saved from webEM
    :param string system_release: (optional) systemReleaseVersion, related with plannedSWReleaseVersion
    :param string cmp_server: (optional) CMP server host
    :param string cmp_ca_subject: (optional) CMP caSubjectName
    :param string output_xml: (optional) Specify a target file name.
    :param string integrate_ver: (optional) version for INTEGRATE, e.g., INT_01
    :return:
    """
    if not os.path.exists(scf_file):
        print("ERROR! Make sure %s exist!" % scf_file)

    parser = ET.XMLParser(remove_blank_text=True)
    tree = ET.parse(scf_file, parser)
    root = tree.getroot().find("{%s}cmData" % XMLNS)

    bts_main_elem = tree.xpath('//*[@class="com.nokia.cu.5g:MRBTS" or @class="com.nokia.vdu.5g:MRBTS"]')
    if len(bts_main_elem) < 1:
        print("ERROR! MRBTS object not found!")
        return

    mrbts_5g_class = bts_main_elem[0].get("class")
    if "cu" in mrbts_5g_class:
        product = "vcu"
    elif "du" in mrbts_5g_class:
        product = "vdu"
    else:
        print("ERROR! Unexpected 5g class: ", mrbts_5g_class)
        return

    orig_mrbts_name = bts_main_elem[0].get("distName")

    if 1 != orig_mrbts_name.count("-"):
        print("ERROR! Unexpected distname: ", orig_mrbts_name)
        return

    cmp_ee_subject = "CN=" + orig_mrbts_name

    _remove_unused_TNL(root, tree)
    _update_distName_for_all(root, orig_mrbts_name)
    _add_element_for_MRBTS(bts_main_elem[0], orig_mrbts_name)
    _add_object_for_INTEGRATE(root, orig_mrbts_name, sw_version, system_release, integrate_ver)
    if product == "vdu":
        _remove_hw_elements(root, tree)
        _add_element_for_MNL(tree, sw_version)
        _add_element_for_CMP(tree, cmp_server, cmp_ca_subject, cmp_ee_subject)  # looks doesn't matter
        _update_oamTls_to_forced(tree)
        _update_parameters_in_NRBTS(tree)
        _update_parameters_in_NRCELL(tree)
        _update_parameters_in_ANTL(tree)
        _update_alSelection_to_static(tree)
    else:
        _update_parameters_in_NRBTS_vcu(tree)

    temp_xml = "scf_converted.xml"
    tree.write(temp_xml, pretty_print=True, xml_declaration=True, encoding="utf-8")
    with open(temp_xml, "r") as f:
        lines = f.readlines()

    cmdata_line = get_close_matches('cmData type="plan" scope="all"', lines)
    if len(cmdata_line) > 0:
        index = lines.index(cmdata_line[0]) + 1
    else:
        index = 3
    part_lines = lines[index: -2]
    with open(output_file, "w") as f:
        f.writelines(part_lines)


def _update_distName_for_all(scf_root, old_dist):
    children = list(scf_root)
    for child in children:
        if child.tag == "{%s}managedObject" % XMLNS:
            dist_name = child.get("distName")
            new_dist = "PLMN-PLMN/" + old_dist
            child.set("distName", dist_name.replace(old_dist, new_dist))
        else:
            scf_root.remove(child)  # remove header and other non-managedObject


def _add_element_for_MRBTS(mrbts_element, new_mrbts_name):
    bts_name_elem = mrbts_element.find("{%s}p[@name='btsName']" % XMLNS)
    bts_name_elem.text = new_mrbts_name
    ET.SubElement(mrbts_element, "p", name="AutoConnSiteID").text = new_mrbts_name


def _add_object_for_INTEGRATE(scf_root, new_mrbts_id, planed_version, system_release, integ_ver):
    new_elem = ET.Element("managedObject")
    new_elem.set("class", "com.nokia.integrate:INTEGRATE")
    new_elem.set("version", integ_ver)
    new_elem.set("distName", "PLMN-PLMN/%s/INTEGRATE-1" % new_mrbts_id)
    new_elem.set("id", "104000")
    new_elem.set("operation", "create")
    scf_root.insert(1, new_elem)
    ET.SubElement(new_elem, "p", name="plannedSWReleaseVersion").text = planed_version
    ET.SubElement(new_elem, "p", name="securityMode").text = "TLS"
    ET.SubElement(new_elem, "p", name="systemReleaseVersion").text = system_release


def _add_element_for_MNL(scf_tree, planed_version):
    target_elem = scf_tree.xpath('//*[@name="productVariantPlanned"]/parent::*[@class="com.nokia.srbts.mnl:MNL"]')
    if len(target_elem) < 1:
        return
    sw_version_elem = target_elem[0].find("{%s}p[@name='plannedSWReleaseVersion']" % XMLNS)
    if sw_version_elem is not None:
        sw_version_elem.text = planed_version
    else:
        ET.SubElement(target_elem[0], "p", name="plannedSWReleaseVersion").text = planed_version


def _add_element_for_CMP(scf_tree, server_host, ca_name, ee_name):  # serverHost, caSubjectName, eeSubjectName
    target_elem = scf_tree.xpath('//*[@name="caCertificateUpdateTime"]/parent::*[@class="com.nokia.srbts.mnl:CMP"]')
    if len(target_elem) < 1:
        return
    ca_subj_elem = target_elem[0].find("{%s}p[@name='caSubjectName']" % XMLNS)
    ee_subj_elem = target_elem[0].find("{%s}p[@name='eeSubjectName']" % XMLNS)
    if ca_subj_elem is not None:
        ca_subj_elem.text = ca_name
    else:
        ET.SubElement(target_elem[0], "p", name="caSubjectName").text = ca_name
    if ee_subj_elem is not None:
        ee_subj_elem.text = ee_name
    else:
        ET.SubElement(target_elem[0], "p", name="eeSubjectName").text = ee_name
    server_elem = target_elem[0].find("{%s}p[@name='serverHost']" % XMLNS)
    if server_elem is not None:
        server_elem.text = server_host

    target_elem2 = scf_tree.xpath('//*[@name="caCertificateUpdateTime"]/parent::*[@class="com.nokia.srbts.mnl:CMPECDSA"]')
    if len(target_elem2) > 1:
        target_elem2[0].remove(target_elem2[0].find("{%s}p[@name='caSubjectName']" % XMLNS))
        target_elem2[0].remove(target_elem2[0].find("{%s}p[@name='eeSubjectName']" % XMLNS))
        target_elem2[0].remove(target_elem2[0].find("{%s}p[@name='serverHost']" % XMLNS))
        server_port_elem = target_elem2[0].find("{%s}p[@name='serverPort']" % XMLNS)
        server_port_elem.text = "1024"


def _update_oamTls_to_forced(scf_tree):
    target_elem = scf_tree.xpath('//*[@name="oamTls"]')
    if len(target_elem) < 1:
        return
    target_elem[0].text = "forced"


def _update_parameters_in_NRBTS(scf_tree):
    target_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:NRBTS"]//*[@name="ulVoipPacketAggrSinrThreshold"]')
    if len(target_elem) < 1:
        return
    target_elem[0].text = "20"  # GUI default value 2.0  UI_value * 10  -20.0 ~ 40.0

    target_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:NRBTS"]//*[@name="ulTxSwitchingBoost"]')
    target_elem[0].text = "1.5"  # update when vDUCNF00_0.300.20720
    # target_elem[0].text = str(int(int(target_elem[0].text) / 10)) if target_elem[0].text != "20" else "20"


def _update_parameters_in_ANTL(scf_tree):
    target_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.eqm:ANTL"]')
    try:
        for elem in target_elem:
            ant_delay_dl = elem.find("{%s}p[@name='antennaPathDelayDL']" % XMLNS)
            ant_delay_dl.text = "20"  # GUI default value:2 Internal value formula = UI_value * 10 2~115000
            ant_delay_ul = elem.find("{%s}p[@name='antennaPathDelayUL']" % XMLNS)
            ant_delay_ul.text = "20"
            total_loss = elem.find("{%s}p[@name='totalLoss']" % XMLNS)
            total_loss.text = "30"
            # ant_delay_ul.text = str(int(int(ant_delay_ul.text) / 10)) if ant_delay_ul.text != "20" else "20"
            # ant_delay_dl.text = str(int(int(ant_delay_dl.text) / 10)) if ant_delay_dl.text != "20" else "20"
            # total_loss.text = str(int(int(total_loss.text) / 10)) if total_loss.text != "30" else "30"
    except Exception as error:
        print(error)


def _update_parameters_in_NRCELL(scf_tree):
    vdu_cell_param = {"dllaBlerTarget": 0.1,  # GUI default value:0.1 UI_value * 100 0.01 ~ 0.99   0.2
                      "dllaDeltaCqiMax": 15,   # 150 -> 15 /10  10
                      "dllaDeltaCqiMin": -15,   # -150 -> -15  /10   -10
                      "dllaDeltaCqiStepdown": 0.25,  # 250 -> 0.25 /1000
                      "dlQam256PowerBackoffSub6": 1.5,  # UI_value * 10   2
                      "pMax": 40,  # Internal value formula:= UI_value * 10  0~60
                      "rloSinrThreshold": -4.5,   # Internal value formula:= UI_value * 10
                      "ueSplitPowerAdjStep": 7,  # (UI_value + 10) * 10
                      "ulRank1to2Thresh": 1.70,  # UI_value * 100
                      "ulRank2to1Thresh": 1.50,  # UI_value * 100
                      "ulTransPrecodeOffSinrThrRedCap": 17,  # UI_value * 10  -5.0 ~ 20.0
                      "ulTransPrecodeOffSinrThresh": 17,  # ulTransPrecodeOnSinrThresh < ulTransPrecodeOffSinrThresh
                      "ulTransPrecodeOnSinrThrRedCap": 15,  # UI_value * 10 -10 ~ 18
                      "ulTransPrecodeOnSinrThresh": 15,  # UI_value * 10  -10.0 ~ 18.0
                      "ullaBlerTarget": 0.1,  # UI_value * 100  0.01 ~ 0.99
                      "ullaDeltaSinrMax": 30,  # UI_value * 10  0 ~ 50
                      "ullaDeltaSinrMin": -30,  # UI_value * 10, -50~ 0
                      "ullaDeltaSinrStepdown": 0.25,
                      "ulLimitedMcsStepupSizeBler": 0,  # 0.00 ~ 0.99
                      "minGuaranteedBudgetRatio": 0.5,
                      "ulSchedTimeIntervalTxSkip": 15,
                      }
    target_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:NRCELL"]//*[starts-with(@name, "dlla") or '
                                 'starts-with(@name, "ulla") or starts-with(@name, "ulTransPrecodeO") or '
                                 'starts-with(@name, "ulRank") and text()]')
    extra_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:NRCELL"]//*[@name="ueSplitPowerAdjStep" or '
                                '@name="ullaBlerTarget" or @name="pMax" or '
                                '@name="dlQam256PowerBackoffSub6" or @name="rloSinrThreshold" or '
                                '@name="actEirpControl" or @name="actUlDftSOfdm" or '
                                '@name="ulLimitedMcsStepupSizeBler" or @name="minGuaranteedBudgetRatio" and text()]')
    # eirpControl/minGuaranteedBudgetRatio, eirpControl/minSignificantNormalizedBeamGain
    # //*[@class="com.nokia.srbts.nrbts:NRCELL"]/*list[@name="eirpControl"]/*item/*p[@name="minGuaranteedBudgetRatio"]
    eirp_list = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:NRCELL"]//*[@name="eirpControlPowerReductionFactorList"]/*')
    target_elem.extend(extra_elem)
    for elem in target_elem:
        elem_name = elem.get("name")
        if elem_name in vdu_cell_param:
            elem.text = str(vdu_cell_param[elem_name])
    for elem in eirp_list:
        elem.text = "0"  # GUI default value 0

def _update_alSelection_to_static(scf_tree):
    target_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:PDCCH"]//*[@name="alSelection"]')
    if len(target_elem) < 1:
        return
    for elem in target_elem:
        elem.text = "static"  # GUI default value: static
    dynamicAggregationLevelSet = {
        "cqiCorrectionUp": 0.01,
        "cqiDciCssAl1": 15.9,
        "cqiDciCssAl16": 15.9,
        "cqiDciCssAl2": 15.9,
        "cqiDciCssAl4": 15.9,
        "cqiDciCssAl8": 15.9,
        "highOlcCqiOffset": 0.01,
        "lowOlcCqiOffset": 0.01
    }
    target_elems = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:PDCCH"]//*[starts-with(@name, "cqi") or '
                                 '@name="highOlcCqiOffset" or @name="lowOlcCqiOffset" and text()]')
    for elem in target_elems:
        elem_name = elem.get("name")
        if elem_name in dynamicAggregationLevelSet:
            elem.text = str(dynamicAggregationLevelSet[elem_name])

def _remove_hw_elements(scf_root, scf_tree):
    target_elem = scf_tree.xpath('//*[starts-with(@class, "com.nokia.eqm.hw:")]')
    if len(target_elem) < 1:
        return
    for elem in target_elem:
        scf_root.remove(elem)


def _remove_unused_TNL(scf_root, scf_tree):
    tnl_list = ['/TNLSVC-1/TNL-1', '/TNLSVC-1/TNL-2', '/TNLSVC-1/TNL-3', '/TNLSVC-1/TNL-4',
                '/TNLSVC-1/TNL-5', '/TNLSVC-1/TNL-6', '/TNLSVC-1/TNL-7', '/TNLSVC-1/TNL-8', '/TNLSVC-1/TNL-9']
    label_elem = scf_tree.xpath('//*[@name="userLabel" and text()="TRUE"]/parent::*[@class="com.nokia.srbts.tnl:TNLTEMPLATE"]')
    for elem in label_elem:
        tnlDN_elem = elem.find("{%s}p[@name='tnlDN']" % XMLNS)
        tmp = tnlDN_elem.text
        tnl_list.remove(tmp[tmp.index("/"):])

    target_elem = scf_tree.xpath('//*[starts-with(@class, "com.nokia.srbts.tnl") and not(contains(@class, "TNLTEMPLATE"))]')
    for elem in target_elem:
        dist_name = elem.get("distName")
        for tnl in tnl_list:
            if tnl in dist_name:
                scf_root.remove(elem)
                break


def _update_parameters_in_NRBTS_vcu(scf_tree):
    vcu_nrbts_param = {"ulTxSwitchingBoost": 1.5,
                       "timerE1BearerProcGuard": 2.5,
                       "timerE1ResetGuard": 2.5,
                       }
    target_elem = scf_tree.xpath('//*[@class="com.nokia.srbts.nrbts:NRBTS"]//*[@name="timerE1BearerProcGuard" or '
                                '@name="timerE1ResetGuard" or @name="ulTxSwitchingBoost" and text()]')
    for elem in target_elem:
        elem_name = elem.get("name")
        if elem_name in vcu_nrbts_param:
            elem.text = str(vcu_nrbts_param[elem_name])


def convert_scf_to_new_version_windows(web_scf_file, target_version, product):
    branch, build_number = target_version.split("_")

    # windows
    os.system("del /F /S /Q migtools")
    os.system("del /F /S /Q result")
    migtools_name = target_version + "_migtools_windows.tgz"
    tool_link = "https://artifactory-hz1.int.net.nokia.com/artifactory/mnp5g-central-public-remote/System_Release/" \
                "{0}/{1}/{2}".format(branch, target_version, migtools_name)
    download_command = "curl -O %s" % tool_link
    os.system(download_command)
    extract_command = "tar xzvf %s -C migtools" % migtools_name
    os.system(extract_command)
    os.system("del /F %s" % migtools_name)
    scf_file_name = os.path.basename(web_scf_file)
    filename, extension = os.path.splitext(scf_file_name)
    scf_updated = ".\\result\\" + filename + "_" + build_number + extension
    feedback = ".\\result\\feedback.json"
    convert_command = ".\\migtools\\migtools_cli.bat {0} {1} {2} {3}".format(product, web_scf_file, scf_updated, feedback)
    os.system(convert_command)
    return scf_updated


def convert_scf_to_new_version_linux(web_scf_file, target_version, product):
    branch, build_number = target_version.split("_")
    # linux
    migtools_name = target_version + "_migtools_linux.tgz"
    tool_link = "https://artifactory-hz1.int.net.nokia.com/artifactory/mnp5g-central-public-remote/System_Release/" \
                "{0}/{1}/{2}".format(branch, target_version, migtools_name)
    local_path = "/home/ute/migtools"
    os.system("rm -rf %s" % local_path)
    os.makedirs(local_path)  # exist_ok=True
    os.chdir(local_path)
    download_command = "wget %s" % tool_link
    os.system(download_command)
    extract_command = "tar xzvf %s" % migtools_name
    os.system(extract_command)
    scf_file_name = os.path.basename(web_scf_file)
    filename, extension = os.path.splitext(scf_file_name)
    output_scf = filename + "_" + build_number + extension
    feedback = "feedback.json"
    convert_command = "./migtools_cli.sh {0} {1} {2} {3}".format(product, web_scf_file, output_scf, feedback)
    os.system(convert_command)
    os.remove(migtools_name)
    return output_scf


if __name__ == '__main__':
    args = sys.argv
    target_file_name = "scf_part_for_pnp"
    if len(args) < 3:
        print("format is: python update_scf.py <input scf> <cnf version> [target_file_name]")
    else:
        web_scf_file = args[1]
        target_version = args[2]
        if len(args) == 4:
            target_file_name = args[3]
        if "vCU" in target_version:
            system_release = "24R3VCU"
            product = "vcu"
        elif "vDU" in target_version:
            system_release = "24R3VDU"
            product = "vdu"
        else:
            print("ERROR: %s is not invalid version." % target_version)
            exit(0)

        scf_dir = os.path.dirname(web_scf_file)
        output_xml_part = os.path.join(scf_dir, target_file_name)
        scf_updated = convert_scf_to_new_version_linux(web_scf_file, target_version, product)
        adapt_scf_to_pnp(scf_updated, system_release, target_version, output_xml_part)
