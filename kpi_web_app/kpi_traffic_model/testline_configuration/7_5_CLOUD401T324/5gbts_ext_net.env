parameters:
  network_opts:
    vnf_name: example-5gbts
    number_of_networks: 2

    # external networks based on flat provider network (sriov)
    networks:

      - name: extnet-a
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.2
        end: 192.168.2.165
        net_type: flat
        ip_ver: 4
        provider: sriov-a
        tenant_id: bdf8c323c4e949a0898bcc56b908da7a

      - name: extnet-b
        cidr: 192.168.12.0/24
        gateway: 192.168.12.1
        start: 192.168.12.2
        end: 192.168.12.165
        net_type: flat
        ip_ver: 4
        provider: sriov-b
        tenant_id: bdf8c323c4e949a0898bcc56b908da7a
