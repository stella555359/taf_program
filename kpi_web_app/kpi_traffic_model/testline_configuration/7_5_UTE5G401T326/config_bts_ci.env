parameters:
  image: AirFrameVirtualized-0.190.4044
  ssh_public_key: "ssh-rsa "
  vnf_name: sq7-tl326
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: sq7-tl326_db
    uvm: sq7-tl326_uvm
    oam: sq7-tl326_oam
    cpcl: sq7-tl326_cpcl
    cpif: sq7-tl326_cpif
    cpnrt: sq7-tl326_cpnrt
    cpnb: sq7-tl326_cpnb
    cpue: sq7-tl326_cpue
    upue: sq7-tl326_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
  timezone: Asia/Shanghai
  uvm_image: AirFrameVirtualized-0.190.4044
  internal_segment_ids:
    internal: 1208
    internal_srv: 1209
    internal_e1: 1223
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: public-oam_net-v46
      fixed_ips: [ip_address: 10.57.159.4]
    f1c:
      uuid: sq7-tl326-fronthaul_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: 'fc00::172:16:87:120']
    x2c:
      uuid: public-backhaul_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2a00:8a00:8000:136:10:57:159:8138']
    s1c:
      uuid: public-backhaul_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2a00:8a00:8000:136:10:57:159:8138']
    f1u:
      uuid: sq7-tl326-fronthaul_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: 'fc00::172:16:87:130']
    x2u:
      uuid: public-backhaul_net-v46 
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2a00:8a00:8000:136:10:57:159:8139']
    s1u:
      uuid: public-backhaul_net-v46 
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2a00:8a00:8000:136:10:57:159:8139']
    tracing:
      uuid: sq7-tl326-tracing_net-v4

  internal_provider_networks: provider0
  internal_e1_provider_networks: provider0
  vnf_layout: basic
  config_external_ip: enabled

  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
