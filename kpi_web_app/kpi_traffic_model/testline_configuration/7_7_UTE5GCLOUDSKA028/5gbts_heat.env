resource_registry:
  RCP::Common::Parameters: modules/5gbts_common_params.yaml
  RCP::Network::Interface: modules/5gbts_network_interface.yaml
  RCP::Network::Pool: modules/5gbts_network_pool.yaml
  RCP::Networks::Redundant: modules/5gbts_network_setup_redundant.yaml
  RCP::Networks::RedundantWithoutOam: modules/5gbts_network_setup_redundant_without_oam.yaml
  RCP::Networks::Basic: modules/5gbts_network_setup_basic.yaml
  RCP::Networks::Layout: modules/5gbts_network_layout.yaml
  RCP::Node::Common::Basic: modules/5gbts_common_node.yaml
  RCP::Node::Common::Redundant: modules/5gbts_common_node_2n.yaml
  RCP::Node::Common::Npuls: modules/5gbts_common_node_nplus.yaml
  RCP::Node::CPIF::Redundant: modules/5gbts_cpif_node_2n.yaml
  RCP::Node::OAM::Basic: modules/5gbts_oam_node.yaml
  RCP::Node::OAM::Redundant: modules/5gbts_oam_node_2n.yaml
  RCP::Node::Storage: modules/5gbts_storage_node.yaml
  RCP::Node::DB::Redundant: modules/5gbts_db_nodes_redundant.yaml
  RCP::Node::DB::Basic: modules/5gbts_db_node.yaml
  RCP::Volume::Attachment: modules/5gbts_volume_attachment.yaml
  RCP::Volume::Local: modules/5gbts_volume_local.yaml
  RCP::Volume::NFS: modules/5gbts_volume_nfs.yaml
  RCP::VolumeGroup::Local: modules/5gbts_volume_group_local.yaml
  RCP::VolumeGroup::NFS: modules/5gbts_volume_group_nfs.yaml
  RCP::Volume::GFS: modules/5gbts_volume_gfs.yaml
  RCP::VolumeGroup::GFS: modules/5gbts_volume_group_gfs.yaml
  5GBTS::Networks::Transformation: modules/5gbts_ext_network_transformation.yaml
  5GBTS::Common::AvailableZones: modules/5gbts_common_available_zones.yaml
  5GBTS::Common::SingleAvailableZone: modules/5gbts_common_single_available_zone.yaml
  RCP::Volume::Cinder: modules/5gbts_volume_cinder.yaml
  RCP::Volume::LVMLocal: modules/5gbts_volume_lvm_local.yaml
  RCP::Volume::LVMNFS: modules/5gbts_volume_lvm_nfs.yaml
  RCP::Volume::LVMGFS: modules/5gbts_volume_lvm_gfs.yaml
  RCP::VolumeGroup::LVMLocal: modules/5gbts_volume_group_lvm_local.yaml
  RCP::VolumeGroup::LVMNFS: modules/5gbts_volume_group_lvm_nfs.yaml
  RCP::VolumeGroup::LVMGFS: modules/5gbts_volume_group_lvm_gfs.yaml
parameters:
  image: 0.190.2554
  ssh_public_key: "ssh-rsa "
  vnf_name: 5gbts
  cluster_id: "28"
  dns_forwarders: [ 10.83.200.2 ]
  dual_stack: disabled
  flavors:
    db: gNB28_db
    uvm: gNB28_uvm
    oam: gNB28_oam
    cpcl: gNB28_cpcl
    cpif: gNB28_cpif
    cpnrt: gNB28_cpnrt
    cpnb: gNB28_cpnb
    cpue: gNB28_cpue
    upue: gNB28_upue
  ntp_servers: 10.83.200.2
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
  timezone: Europe/Warsaw
  uvm_image: 0.190.2554
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: Netact-CU_m_net-v4
      fixed_ips: [ip_address: 10.83.250.7]
    f1c:
      uuid: Netact-CU_f1c_net-v4
      fixed_ips: [ip_address: 10.83.250.135]
    x2c:
      uuid: Netact-CU_x2c_net-v4
      fixed_ips: [ip_address: 10.83.250.40]
    f1u:
      uuid: Netact-CU_f1u_net-v4
      fixed_ips: [ip_address: 10.83.250.167]
    x2u:
      uuid: Netact-CU_x2u_net-v4
      fixed_ips: [ip_address: 10.83.250.72]
    s1u:
      uuid: Netact-CU_s1u_net-v4
      fixed_ips: [ip_address: 10.83.250.103]
    tracing:
      uuid: tracing_net
  internal_provider_networks: providerInternal
  internal_e1_provider_networks: providerInternal
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
