parameters:
  network_opts:
    vnf_name: TL23-5gbts
    dns_forwarders: 10.171.0.1
    number_of_networks: 4 

    # all external networks
    networks:

      - name: oam
        cidr: 10.41.170.128/27
        gateway: 10.41.170.129
        start: 10.41.170.147
        end: 10.41.170.149
        net_type: vlan
        sid: 114
        ip_ver: 4
        provider: external

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 2300
        ip_ver: 4
        provider: internal

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3001
        ip_ver: 4
        provider: external

      - name: tracing
        cidr: 192.168.5.0/24
        gateway: 192.168.5.1
        start: 192.168.5.100
        end: 192.168.5.200
        net_type: vlan
        sid: 3300
        ip_ver: 4
        provider: external

