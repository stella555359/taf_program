resource_registry:
  RCP::Common::Parameters: modules/5gap_common_params.yaml
  RCP::Network::Interface: modules/5gap_network_interface.yaml
  RCP::Network::Pool: modules/5gap_network_pool.yaml
  RCP::Networks::Basic: modules/5gap_network_setup_basic.yaml
  RCP::Networks::Layout: modules/5gap_network_layout.yaml
  RCP::Node::Common::Basic: modules/5gap_common_node.yaml
  RCP::Node::OAM::Basic: modules/5gap_oam_node.yaml
  RCP::Node::DB::Basic: modules/5gap_db_node.yaml
  RCP::Volume::Attachment: modules/5gap_volume_attachment.yaml
  RCP::Volume::Local: modules/5gap_volume_local.yaml
  RCP::Volume::NFS: modules/5gap_volume_nfs.yaml
  RCP::VolumeGroup::Local: modules/5gap_volume_group_local.yaml
  RCP::VolumeGroup::NFS: modules/5gap_volume_group_nfs.yaml
  RCP::Volume::GFS: modules/5gap_volume_gfs.yaml
  RCP::VolumeGroup::GFS: modules/5gap_volume_group_gfs.yaml
  5GAP::Check::Networks: modules/5gap_ext_network_setting_check.yaml
  5GAP::Networks::Transformation: modules/5gap_ext_network_transformation.yaml
parameters:
  image: 
  ssh_public_key: "ssh-rsa "
  vnf_name: 5gap
  availability_zone: nova
  cluster_id: 13
  dns_forwarders: [ 10.171.0.1 ]
  flavors:
    db: 5gap_db
    uvm: 5gap_uvm
    oam: 5gap_oam
    cpue: 5gap_cpue
    upue: 5gap_upue
  ntp_servers: 10.171.8.4
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Asia/Kolkata
  uvm_image: 
  vif_model: avp
  internal_segment_ids:
    internal: 2401
    internal_srv: 2402
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  external_networks:
    oam:
      uuid: 
      fixed_ips: [ip_address: 10.41.170.152]
    fronthaul:
      uuid: 
      fixed_ips: []
    wts:
      uuid: 
    tracing:
      uuid: 

  internal_provider_networks: internal_ap
  config_external_ip: enabled

  extra_cloud_config_data:
   system_info:
     default_user:
       name: robot
   users:
   - default
   - name: robot
     gecos: Robot user for test automation purposes
     primary-group: root
     lock_passwd: false
     plain_text_passwd: 'rastre1'
     home: /home/robot
     shell: /bin/bash
     sudo:
     - ALL=(ALL) NOPASSWD:ALL
   write_files:
   - content: |
       robot
     path: /etc/opt/nokia/setupsshkey.d/testusers
     permissions: '0644'
