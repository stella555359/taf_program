parameters:
  image: AirFrameVirtualized-0.200.952
  ssh_public_key: "ssh-rsa "
  vnf_name: cran27
  cluster_id: "1"
  dns_forwarders: 2a00:8a00:8000:117:1:1F:0:1
  network-interface-enable: true
  flavors:
    db: TL-7_5_UTE5GAIC001T01098_flavor_db
    uvm: TL-7_5_UTE5GAIC001T01098_flavor_uvm
    oam: TL-7_5_UTE5GAIC001T01098_flavor_oam
    cpcl: TL-7_5_UTE5GAIC001T01098_flavor_cpcl
    cpif: TL-7_5_UTE5GAIC001T01098_flavor_cpif
    cpnrt: TL-7_5_UTE5GAIC001T01098_flavor_cpnrt
    cpnb: TL-7_5_UTE5GAIC001T01098_flavor_cpnb
    cpue: TL-7_5_UTE5GAIC001T01098_flavor_cpue
    upue: TL-7_5_UTE5GAIC001T01098_flavor_upue
  ntp_servers: 2a00:8a00:8000:117:1:17:0:10
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
    wsuser: '$6$rounds=10000$eG4lsC1E5KqcMjYS$E6Zq45tZLtxSRXzT9lpqJjQcyhoQpyHR1bLTGRpYxCbPIs4WDW7PrGhV4uVY0hptxsTZU753MpbgxKArio2hh/'
  timezone: Asia/Shanghai
  uvm_image: AirFrameVirtualized-0.200.952
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: 7ae8c374-3ad7-46f4-a2e6-927c3af86be7
      fixed_ips: [ip_address: '2a00:8a00:8000:5801:0:4:0:30']
    f1c:
      uuid: 426eac23-4d82-48e8-865d-1d7407e3aad2
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2a00:8a00:8000:5801:0:5:0:30']
    x2c:
      uuid: b2a2f26e-fdb3-4284-981a-4a8954eba5c3
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2a00:8a00:8000:5801:0:6:0:30']
    f1u:
      uuid: 426eac23-4d82-48e8-865d-1d7407e3aad2
      fixed_ips: []
      fixed_v6_ips: []
    x2u:
      uuid: cdfe3a2c-72af-497d-9bc7-9f108816f386
      fixed_ips: []
      fixed_v6_ips: []
    s1u:
      uuid: cdfe3a2c-72af-497d-9bc7-9f108816f386
      fixed_ips: []
      fixed_v6_ips: []
    tracing:
      uuid: e88e288a-cbc6-429f-9194-bcae510fbcb3

  internal_provider_networks: provider0
  internal_e1_provider_networks: provider0
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
