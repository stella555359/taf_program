parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: 5gbts-190
    dns_forwarders: 10.83.200.2
    networks:
      - name: fronthaul
        cidr: 172.16.5.0/24
        gateway: 172.16.5.254
        start: 172.16.5.100
        end: 172.16.5.200
        ip_ver: 4
#        cidr: 2a:2::/64
#        gateway: 2a:2::fe
#        start:  2a:2::1
#        end:  2a:2::20
#        ip_ver: 6
        net_type: vlan
        sid: 1690
        provider: providerFronthaul
      - name: backhaul
        cidr: 172.16.2.0/24
        gateway: 172.16.2.254
        start: 172.16.2.100
        end: 172.16.2.200
        ip_ver: 4
#        cidr: 2a:1::/64
#        gateway: 2a:1::fe
#        start: 2a:1::1
#        end: 2a:1::20
#        ip_ver: 6
        net_type: vlan
        sid: 2690
        provider: providerBackhaul
      #- name: tracing
        #cidr: 172.16.4.0/24
        #gateway: 172.16.4.254
        #start: 172.16.4.100
        #end: 172.16.4.200
