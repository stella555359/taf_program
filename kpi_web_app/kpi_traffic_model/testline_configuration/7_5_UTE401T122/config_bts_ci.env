parameters:
  image: AirFrameVirtualized-0.190.1896
  ssh_public_key: "ssh-rsa "
  vnf_name: mmw2-tl122
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  network-interface-enable: true
  flavors:
    db: mmw2-tl122_db
    uvm: mmw2-tl122_uvm
    oam: mmw2-tl122_oam
    cpcl: mmw2-tl122_cpcl
    cpif: mmw2-tl122_cpif
    cpnrt: mmw2-tl122_cpnrt
    cpnb: mmw2-tl122_cpnb
    cpue: mmw2-tl122_cpue
    upue: mmw2-tl122_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
  timezone: Asia/Shanghai
  uvm_image: AirFrameVirtualized-0.190.1896
  internal_segment_ids:
    internal: 1308
    internal_srv: 1309
    internal_e1: 1310
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: oam_net
      fixed_ips: [ip_address: 10.57.250.7]
    f1c:
      uuid: fronthaul_net
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:8000:136:10:57:250:4077"]
    x2c:
      uuid: backhaul_net
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:8000:136:10:57:250:8002"]
    f1u:
      uuid: fronthaul_net
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:8000:136:10:57:250:4078"]
    x2u:
      uuid: backhaul_net
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:8000:136:10:57:250:8003"]
    s1u:
      uuid: backhaul_net
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:8000:136:10:57:250:8003"]
    tracing:
      uuid: tracing_net

  internal_provider_networks: provider1
  internal_e1_provider_networks: provider1
  vnf_layout: basic
  config_external_ip: enabled

  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
