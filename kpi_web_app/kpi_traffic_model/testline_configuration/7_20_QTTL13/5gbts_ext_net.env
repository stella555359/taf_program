parameters:
  network_opts:
    dns_forwarders: 135.117.48.1
    number_of_networks: 4
    vnf_name: 5gbts

    networks:

    - cidr: 192.168.255.0/24
      end: 192.168.255.110
      gateway: 192.168.255.254
      ip_ver: 4
      name: oam
      net_type: vlan
      provider: physnet1
      sid: 2200
      start: 192.168.255.100

    - cidr: 192.168.2.0/24
      end: 192.168.2.200
      gateway: 192.168.2.1
      ip_ver: 4
      name: fronthaul
      net_type: vlan
      provider: physnet3
      sid: 2100
      start: 192.168.2.100

    - cidr: 192.168.4.0/24
      end: 192.168.4.200
      gateway: 192.168.4.1
      ip_ver: 4
      name: backhaul
      net_type: vlan
      provider: physnet1
      sid: 3001
      start: 192.168.4.100

    - name: tracing
      cidr: 192.168.5.0/24
      gateway: 192.168.5.1
      start: 192.168.5.100
      end: 192.168.5.200
      net_type: vlan
      sid: 4000
      ip_ver: 4
      provider: physnet1

