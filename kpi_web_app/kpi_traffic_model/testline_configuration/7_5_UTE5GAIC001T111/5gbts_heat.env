parameters:
  image: AirFrameVirtualized-10.1100.987
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: hgz-5309
  cluster_id: '01'
  vnfc_type_name_case: upper
  flavors:
    oam: hgz-5309_oam
    cpcl: hgz-5309_cpcl
    cpif: hgz-5309_cpif
    cpnb: hgz-5309_cpnb
    cpnrt: hgz-5309_cpnrt
    cpue: hgz-5309_cpue
    upue: hgz-5309_upue
    uvm: hgz-5309_uvm
    db: hgz-5309_db
  timezone: Asia/Shanghai
  network-interface-enable: true
  oam_network: OAM-v4
  oam_ip_logical: 10.107.169.134
  oam_ip_0: 10.107.169.132
  oam_ip_1: 10.107.169.133
  oam_default_gw: 10.107.169.129
  ntp_servers: [ '10.56.126.22' ]
  dns_forwarders: [ '10.56.126.31' ]
  internal_network: wbztest-5gbts19b-internal_net-v4
  internal_srv_network: wbztest-5gbts19b-internal_srv_net-v4
  internal_e1_network: wbztest-5gbts19b-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
    internal_e1: [ 192.168.5.0/24, 192.168.5.2, 192.168.5.165 ]
  external_networks:
    extnet_a: extnet-a
    extnet_b: extnet-b
  ext_port:
    nuage_netpartition_name: ""
    f1om_sid: 1804
    fronthaul_cpif_sid: 1806
    fronthaul_upue_sid: 1806
    backhaul_cpif_sid: 1802
    backhaul_upue_sid: 1802
    round_check_sid: 10
    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '10.107.51.8/24' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '10.107.51.7/24' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '10.107.51.9/24' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [ '10.107.51.10/24']
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [ '10.107.51.11/24' ]
    f1om_role_cpnrt_0: Tracing
    f1om_ip_cpnrt_0: [ '10.107.51.12/24' ]
    f1om_role_cpnrt_1: Tracing
    f1om_ip_cpnrt_1: [ ]
    f1om_role_oam_0: Tracing
    f1om_ip_oam_0: [ '10.107.51.5/24' ]
    f1om_role_oam_1: Tracing
    f1om_ip_oam_1: ['10.107.51.6/24' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '10.107.54.196/26' ]
    backhaul_role_cpif: 'X2-C'
    backhaul_ip_cpif: [ '10.107.54.68/26' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [ '10.107.54.197/26']
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [ '10.107.54.69/26']

  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1400
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1400
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
        - nova
        - nova
  oam_security_group:
  number_of_upue_nodes: 1
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  cleartextpassword:
    georesiliency: 'VpOn9JSX6r%G#T'
    wsuser: 'A0zY~rP#8Mx@'
  password:
    _nokfsoperator: '!'
    root: '!'
    georesiliency: '$5$rounds=10000$YLkADD9q$/7cX20b5eNgcjvnN1kteCmZR4siF6oQfW1/9hzh4YZ7'
    wsuser: '$5$rounds=10000$6Kj3xARF$6D8XNkLOFxc8yswG4hhvCXyCdHau5WY6yxH/ZxRrle8'
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
