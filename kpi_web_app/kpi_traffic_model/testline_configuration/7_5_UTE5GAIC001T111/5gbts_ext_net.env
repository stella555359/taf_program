parameters:
  network_opts:
    vnf_name: example-5gbts
    number_of_networks: 0

    # external networks based on flat provider network (sriov)
    networks:

      - name: extnet-c
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
