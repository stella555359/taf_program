        net_type: flat
        ip_ver: 4
        provider: sriov-a
        tenant_id: ee5877fd4102431eb3ac60d29c5daf3c

      - name: extnet-d
        cidr: 192.168.12.0/24
        gateway: 192.168.12.1
        start: 192.168.12.2
        end: 192.168.12.165
        net_type: flat
        ip_ver: 4
        provider: sriov-b
        tenant_id: ee5877fd4102431eb3ac60d29c5daf3c
