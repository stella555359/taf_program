parameters:
  vnf_name: mmwsg1-tl255
  cluster_id: "255"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: mmwsg01_tl255_db
    uvm: mmwsg01_tl255_uvm
    oam: mmwsg01_tl255_oam
    cpcl: mmwsg01_tl255_cpcl
    cpif: mmwsg01_tl255_cpif
    cpnrt: mmwsg01_tl255_cpnrt
    cpnb: mmwsg01_tl255_cpnb
    cpue: mmwsg01_tl255_cpue
    upue: mmwsg01_tl255_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  timezone: Asia/Shanghai
  internal_segment_ids:
    internal: 1300
    internal_srv: 1301
    internal_e1: 1302
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: 6b798b97-d911-4a2e-857d-baf1453e4052
      fixed_ips: [ip_address: 10.57.177.5]
    f1c:
      uuid: 4fc1d2cf-3721-4617-977e-1c5f54427a2d
      fixed_ips: [ip_address: 10.57.177.70]
      fixed_v6_ips: []
    x2c:
      uuid: 4067921d-ea34-45c2-8450-4826b24f4356
      fixed_ips: [ip_address: 10.57.177.134]
      fixed_v6_ips: []
    f1u:
      uuid: 4fc1d2cf-3721-4617-977e-1c5f54427a2d
      fixed_ips: [ip_address: 10.57.177.71]
      fixed_v6_ips: []
    x2u:
      uuid: 4067921d-ea34-45c2-8450-4826b24f4356
      fixed_ips: [ip_address: 10.57.177.135]
      fixed_v6_ips: []
    s1u:
      uuid: 4067921d-ea34-45c2-8450-4826b24f4356
      fixed_ips: [ip_address: 10.57.177.135]
      fixed_v6_ips: []
    tracing:
      uuid: 2ab8c0cd-51e6-4f9a-a8fa-464211da87a0

  internal_provider_networks: provider1
  internal_e1_provider_networks: provider1
  vnf_layout: basic
  config_external_ip: enabled

  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
