resource_registry:
  5GAP::Node::Oam: modules/5gap_oam_node.yaml
  5GAP::Node::Common: modules/5gap_common_node.yaml
  5GAP::Network::Setup: modules/5gap_networks_setup.yaml
  5GAP::Network::Interface: modules/5gap_interface.yaml
  5GAP::Network::FixedIPInterface: modules/5gap_fixed_ip_interface.yaml
  5GAP::Networks::Common: modules/5gap_common_interfaces.yaml
  5GAP::Networks::OAM: modules/5gap_oam_interfaces.yaml
  RCP::Volume::Local: modules/5gap_volume_local.yaml
  RCP::VolumeGroup::Local: modules/5gap_volume_group_local.yaml
  RCP::Volume::NFS: modules/5gap_volume_nfs.yaml
  RCP::VolumeGroup::NFS: modules/5gap_volume_group_nfs.yaml
  RCP::Volume::Attachment: modules/5gap_volume_attachment.yaml
parameters:
  image: ae7e6abc-ee18-4f4c-b126-d0426ba31e43
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: tl3-airphone
  cluster_id: 1
  flavors:
    oam: 5gap_oam
    cpue: 5gap_cpue
    upue: 5gap_upue
    uvm: 5gap_uvm
  timezone: Asia/Shanghai
  oam_network: 912ecd0f-8916-4cd8-9898-3e3e9868d4de
  oam_ip: 10.57.212.63
  ntp_servers: 10.56.126.22
  dns_forwarders: [ 10.56.126.31 ]
  password:
    _nokadmin:         #password for _nokadmin
    _nokfsoperator:    #password for _nokfsoperator
    root:              #password for root
  internal_networks:
    internal: [ 169.254.0.0/19, 169.254.0.2, 169.254.0.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
    management: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
  external_networks:
    backhaul: 88a5f9bc-46fb-4a9b-b419-98f8ceb05bd2
    fronthaul: 8e8ca071-2473-43e1-b7ff-3a1ab6ad2c90
  internal_provider_networks: Internal
  vnfc_layout: 5G18A
  availability-zone: nova
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
