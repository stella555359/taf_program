parameters:
  network_opts:
    vnf_name: tl3-airphone
    dns_forwarders: 10.10.10.10
    number_of_networks: 2

    # all external networks
    networks:

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 2023
        ip_ver: 4
        provider: External

      - name: backhaul
        cidr: 192.168.6.0/24
        gateway: 192.168.6.1
        start: 192.168.6.100
        end: 192.168.6.200
        net_type: vlan
        sid: 2043
        ip_ver: 4
        provider: External

