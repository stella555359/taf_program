parameters:
  network_opts:
    vnf_name: tl3-gnb
    dns_forwarders: 10.10.10.10
    networks:
      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 2010
        ip_ver: 4
        provider: External
      - name: tracing
        cidr: 192.168.5.0/24
        gateway: 192.168.5.1
        start: 192.168.5.100
        end: 192.168.5.200
        net_type: vlan
        sid: 2033
        ip_ver: 4
        provider: External

