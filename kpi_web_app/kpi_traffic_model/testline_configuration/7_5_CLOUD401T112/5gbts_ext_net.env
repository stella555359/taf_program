        provider: physnet13-3

      - name: backhaul
        cidr: fc00::172:18:10:0/112
        gateway: fc00::172:18:10:1
        start: fc00::172:18:10:100
        end: fc00::172:18:10:200
        net_type: vlan
        sid: 1012
        ip_ver: 6
        provider: physnet13-1

      - name: tracing
        cidr: fc00::172:18:4:0/112
        gateway: fc00::172:18:4:1
        start: fc00::172:18:4:100
        end: fc00::172:18:4:200
