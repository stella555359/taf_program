parameters:
  image: AirFrameVirtualized-0.135.601
  ssh_public_key: "ssh-rsa "
  vnf_name: hgz-tl112
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ '2a00:8a00:8000:101::2' ]
  flavors:
    db: hgz-tl112_db
    sn: hgz-tl112_sn
    uvm: hgz-tl112_uvm
    oam: hgz-tl112_oam
    cpcl: hgz-tl112_cpcl
    cpif: hgz-tl112_cpif
    cpnrt: hgz-tl112_cpnrt
    cpnb: hgz-tl112_cpnb
    cpue: hgz-tl112_cpue
    upue: hgz-tl112_upue
  ntp_servers: 2a00:8a00:8000:101::6
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Asia/Shanghai
  uvm_image: AirFrameVirtualized-0.135.601
  internal_segment_ids:
    internal: 1812
    internal_srv: 2212
    internal_e1: 1412
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: 78e6ec09-38cd-42d2-82e0-04f99d23753c
      fixed_ips: [ip_address: "2a00:8a00:8000:136:10:57:170:4"]
    f1m:
      uuid: 55f62778-95b1-43af-8ea0-dda4aac8c6c6
      fixed_ips: []
    f1c:
      uuid: 55f62778-95b1-43af-8ea0-dda4aac8c6c6
      fixed_ips: []
    x2c:
      uuid: 3a1cee53-464c-4d64-b463-a777f3aae4f8
      fixed_ips: [ip_address: "fc00::172:18:10:10"]
    s1c:
      uuid: 3a1cee53-464c-4d64-b463-a777f3aae4f8
      fixed_ips: [ip_address: "fc00::172:18:10:10"]
    f1u:
      uuid: 55f62778-95b1-43af-8ea0-dda4aac8c6c6
      fixed_ips: []
    x2u:
      uuid: 3a1cee53-464c-4d64-b463-a777f3aae4f8
      fixed_ips: []
    s1u:
      uuid: 3a1cee53-464c-4d64-b463-a777f3aae4f8
      fixed_ips: []
    tracing:
      uuid: 21254d84-abce-44e6-bad3-24b49504f6ec

  internal_provider_networks: physnet13-3
  internal_e1_provider_networks: physnet13-3
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
