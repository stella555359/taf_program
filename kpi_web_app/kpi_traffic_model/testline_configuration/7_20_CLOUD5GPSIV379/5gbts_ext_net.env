parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: 5gbts19b
    dns_forwarders: 10.10.10.10
    networks:
      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.49.214
        end: 10.14.49.214
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        ip_ver: 4
        net_type: vlan
        sid: 1133
        provider: physnet3

      - name: backhaul
        cidr: 10.28.24.232/29
        gateway: 10.28.24.238
        start: 10.28.24.233
        end: 10.28.24.234 
        ip_ver: 4
        net_type: vlan
        sid: 4004
        provider: physnet1

      - name: tracing
        cidr: 172.16.4.0/24
        gateway: 172.16.4.1
        start: 172.16.4.100
        end: 172.16.4.200
        net_type: vlan
        sid: 1501
        ip_ver: 4
        provider: physnet3

