parameters:
  image: AirFrameVirtualized-7.3106.80
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: 5gbts19b
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: 5gbts19b_db
    uvm: 5gbts19b_uvm
    oam: 5gbts19b_oam
    cpcl: 5gbts19b_cpcl
    cpif: 5gbts19b_cpif
    cpnrt: 5gbts19b_cpnrt
    cpnb: 5gbts19b_cpnb
    cpue: 5gbts19b_cpue
    upue: 5gbts19b_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  timezone: Europe/Paris
  uvm_image: AirFrameVirtualized-7.3106.80
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.13.0/24, 192.168.13.2, 192.168.13.165 ]
  external_networks:
    oam:
      uuid: 6667705c-7711-4f5e-9496-7771853b2be0
      fixed_ips: [ip_address: 10.14.49.214]
    f1m:
      uuid: ffb3dfde-a526-4d53-b733-df65032aef88
      fixed_ips: []
      fixed_v6_ips: []
    f1c:
      uuid: ffb3dfde-a526-4d53-b733-df65032aef88
      fixed_ips: []
      fixed_v6_ips: []
    x2c:
      uuid: 978dcd46-66b6-44fa-89c0-551aaec9902a
      fixed_ips: []
      fixed_v6_ips: []
    s1c:
      uuid: 978dcd46-66b6-44fa-89c0-551aaec9902a
      fixed_ips: []
      fixed_v6_ips: []
    f1u:
      uuid: ffb3dfde-a526-4d53-b733-df65032aef88
      fixed_ips: []
      fixed_v6_ips: []
    x2u:
      uuid: 978dcd46-66b6-44fa-89c0-551aaec9902a
      fixed_ips: []
      fixed_v6_ips: []
    s1u:
      uuid: 978dcd46-66b6-44fa-89c0-551aaec9902a
      fixed_ips: []
      fixed_v6_ips: []
    tracing:
      uuid: 064e5984-22a9-4d0b-a475-8bad105b4177

  internal_provider_networks: physnet3
  internal_e1_provider_networks: physnet3
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0777'

