parameters:
  network_opts:
    vnf_name: exemple-5gbts 
    dns_forwarders: 10.10.10.10
    number_of_networks: 3

    # all external networks
    networks:

      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.48.91
        end: 10.14.48.91
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1

      - name: fronthaul
        cidr: 192.168.3.0/24
        gateway: 192.168.3.1
        start: 192.168.3.111
        end: 192.168.3.113
        net_type: vlan
        sid: 1100
        ip_ver: 4
        provider: physnet3

      - name: backhaul
        cidr: 10.33.0.0/24
        gateway: 10.33.0.1
        start: 10.33.0.146
        end: 10.33.0.148
        net_type: vlan
        sid: 3100
        ip_ver: 4
        provider: physnet1

