resource_registry:
  5GBTS::Node::Oam: modules/5gbts_oam_node.yaml
  5GBTS::Node::Common: modules/5gbts_common_node.yaml
  5GBTS::Network::Setup: modules/5gbts_networks_setup.yaml
  5GBTS::Network::Interface: modules/5gbts_interface.yaml
  5GBTS::Network::FixedIPInterface: modules/5gbts_fixed_ip_interface.yaml
  5GBTS::Networks::Common: modules/5gbts_common_interfaces.yaml
  5GBTS::Networks::OAM: modules/5gbts_oam_interfaces.yaml
  RCP::Volume::Local: modules/5gbts_volume_local.yaml
  RCP::VolumeGroup::Local: modules/5gbts_volume_group_local.yaml
  RCP::Volume::NFS: modules/5gbts_volume_nfs.yaml
  RCP::VolumeGroup::NFS: modules/5gbts_volume_group_nfs.yaml
  RCP::Volume::Attachment: modules/5gbts_volume_attachment.yaml
parameters:
  image: AirFrameVirtualized-4.2113.272
  ssh_public_key: "ssh-rsa  Generated-by-Nova"

  vnf_name: cv91-5gbts
  cluster_id: 1
  flavors:
    oam: 5gbts_oam
    cpcn: 5gbts_cpcn
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Europe/Paris
  oam_network: d9bd8a5f-b5fc-4451-a533-716bb6a407ba
  oam_ip: 10.14.48.91
  ntp_servers: 135.117.56.60
  dns_forwarders: [ 135.117.48.1 ]
  password:
    _nokadmin:         #password for _nokadmin
    _nokfsoperator:    #password for _nokfsoperator
    root:              #password for root
  internal_networks:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  external_networks:
    backhaul: c9024c56-8143-4989-ad5f-4e4a586a17f5
    fronthaul: a98628cc-c1fa-49f2-ad42-e7c54c2f61d5
  internal_provider_networks: physnet3
  vnfc_layout: 5G18A
  number_of_upue_nodes: 1 
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  number_of_db_nodes: 1
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'

  
