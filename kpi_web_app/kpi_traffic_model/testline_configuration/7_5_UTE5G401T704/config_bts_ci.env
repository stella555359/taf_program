  5GBTS::VolumeGroup::LVMGFS: modules/5gbts_volume_group_lvm_gfs.yaml
parameters:
  image: 0.190.2540
  ssh_public_key: "ssh-rsa "
  vnf_name: mmw-tl704
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  network-interface-enable: true
  flavors:
    db: mmw_tl704_db
    uvm: mmw_tl704_uvm
    oam: mmw_tl704_oam
    cpcl: mmw_tl704_cpcl
    cpif: mmw_tl704_cpif
    cpnrt: mmw_tl704_cpnrt
    cpnb: mmw_tl704_cpnb
    cpue: mmw_tl704_cpue
    upue: mmw_tl704_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  cleartextpassword:
    georesiliency: 'VpOn9JSX6r%G#T'
    wsuser: 'A0zY~rP#8Mx@'
  password:
    _nokfsoperator: '!'
    root: '!'
    georesiliency: '$5$rounds=10000$YLkADD9q$/7cX20b5eNgcjvnN1kteCmZR4siF6oQfW1/9hzh4YZ7'
    wsuser: '$5$rounds=10000$6Kj3xARF$6D8XNkLOFxc8yswG4hhvCXyCdHau5WY6yxH/ZxRrle8'
  timezone: Asia/Shanghai
  uvm_image: 0.190.2540
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: public-oam_net-v46
      fixed_ips: [ip_address: 10.57.181.4]
    f1c:
      uuid: public-fronthaul_net-v46
      fixed_ips: [ip_address: 10.57.181.36]
      fixed_v6_ips: []
    x2c:
      uuid: public-backhaul_net-v46
      fixed_ips: [ip_address: 10.57.181.68]
      fixed_v6_ips: []
    f1u:
      uuid: public-fronthaul_net-v46
      fixed_ips: [ip_address: 10.57.181.37]
      fixed_v6_ips: []
    x2u:
      uuid: public-backhaul_net-v46
      fixed_ips: [ip_address: 10.57.181.69]
      fixed_v6_ips: []
    s1u:
      uuid: public-backhaul_net-v46
      fixed_ips: [ip_address: 10.57.181.69]
      fixed_v6_ips: []
    tracing:
      uuid: public-tracing_net-v46

  internal_provider_networks: provider0
  internal_e1_provider_networks: provider0
  vnf_layout: basic
  config_external_ip: enabled

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: |
        { "nonRootFullBashEnabled": true }
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'