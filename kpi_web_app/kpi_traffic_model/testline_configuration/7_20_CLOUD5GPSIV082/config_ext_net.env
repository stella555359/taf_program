parameters:
  network_opts:
    vnf_name: 5gbts-cv82
    dns_forwarders: 192.168.255.126
    number_of_networks: 4

    # all external networks
    networks:

    - name: cv82_fronthaul
      cidr: 192.168.2.0/24
      gateway: 192.168.2.254
      start: 192.168.2.110
      end: 192.168.2.120
      net_type: vlan
      sid: 1100
      ip_ver: 4
      provider: physnet3

    - name: cv82_backhaul
      cidr: 192.168.4.0/24
      gateway: 192.168.4.254
      start: 192.168.4.100
      end: 192.168.4.200
      net_type: vlan
      sid: 3001
      ip_ver: 4
      provider: physnet1

    - name: cv82_tracing
      cidr: 192.168.5.0/24
      gateway: 192.168.5.254
      start: 192.168.5.1
      end: 192.168.5.25
      net_type: vlan
      sid: 3002
      ip_ver: 4
      provider: physnet3

    - name: cv82_oam
      cidr: 10.14.48.0/23
      gateway: 10.14.49.254
      start: 10.14.48.82
      end: 10.14.48.82
      net_type: vlan
      sid: 1000
      ip_ver: 4
      provider: physnet1

