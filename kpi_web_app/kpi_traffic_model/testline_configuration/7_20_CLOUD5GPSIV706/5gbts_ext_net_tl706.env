parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: tl706
    dns_forwarders: 135.117.48.1
    networks:
      - name: oam
        cidr: 192.168.255.0/24
        gateway: 192.168.255.254
        start: 192.168.255.100
        end: 192.168.255.100
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1
      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        ip_ver: 4
        cidr_v6: fc00::192:168:2:0/112
        gateway_v6: fc00::192:168:2:1
        start_v6:  fc00::192:168:2:100
        end_v6:  fc00::192:168:2:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 1100
        provider: physnet3
      - name: backhaul
        cidr: 10.33.0.0/23
        gateway: 10.33.0.1
        start: 10.33.0.148
        end: 10.33.0.149
        ip_ver: 4
        cidr_v6: fc00::172:16:2:0/112
        gateway_v6: fc00::172:16:2:1
        start_v6: fc00::172:16:2:100
        end_v6: fc00::172:16:2:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 4002
        provider: physnet1
      - name: tracing
        cidr: 172.16.4.0/24
        gateway: 172.16.4.1
        start: 172.16.4.100
        end: 172.16.4.200
        net_type: vlan
        sid: 4090
        ip_ver: 4
        provider: physnet1

