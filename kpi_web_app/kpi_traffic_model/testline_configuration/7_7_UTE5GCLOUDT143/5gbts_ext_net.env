parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: 5gbts-143
    dns_forwarders: 10.83.200.2
    networks:
      - name: fronthaul
        cidr: 172.16.5.0/24
        gateway: 172.16.5.1
        start: 172.16.5.100
        end: 172.16.5.200
        ip_ver: 4
        cidr_v6: fc00::172:16:5:0/112
        gateway_v6: fc00::172:16:5:1
        start_v6:  fc00::172:16:5:100
        end_v6:  fc00::172:16:5:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 1643
        provider: providerFronthaul
      - name: backhaul
        cidr: 172.16.2.0/24
        gateway: 172.16.2.1
        start: 172.16.2.100
        end: 172.16.2.200
        ip_ver: 4
        cidr_v6: fc00::172:16:2:0/112
        gateway_v6: fc00::172:16:2:1
        start_v6: fc00::172:16:2:100
        end_v6: fc00::172:16:2:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 2643
        provider: providerBackhaul
