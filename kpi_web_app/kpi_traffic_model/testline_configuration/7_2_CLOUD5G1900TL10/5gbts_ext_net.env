parameters:
  network_opts:
    vnf_name: TL10-5gbts
    dns_forwarders: 10.170.0.1
    number_of_networks: 3

    # all external networks
    networks:

      - name: oam
        cidr: 10.43.205.160/27
        gateway: 10.43.205.161
        start: 10.43.205.178
        end: 10.43.205.180
        net_type: vlan
        sid: 614
        ip_ver: 4
        provider: External

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.111
        end: 192.168.2.113
        net_type: vlan
        sid: 2100
        ip_ver: 4
        provider: Internal

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3001
        ip_ver: 4
        provider: External

