parameters:
  availability_zones:
    cpcl_000: compute4
    cpcl_001: nova
    cpif_000: compute4
    cpif_001: nova
    cpnb_000: compute2
    cpnb_001: nova
    cpnrt_000: compute2
    cpues:
      availability_zone_list:
      - compute4
      default: compute4
    db_000: compute2
    db_001: nova
    db_002: nova
    default: nova
    oam_000: compute2
    oam_001: nova
    upues:
      availability_zone_list:
      - compute4
      default: compute4
    uvm: nova
  cluster_id: '316'
  config_external_ip: enabled
  dns_forwarders:
  - 2a00:8a02:60:1c:ffff:ffff:ffff:fffd
  dual_stack: disabled
  external_networks:
    f1c:
      fixed_ips:
      - ip_address: 2a00:2222:2222:2222:2222:2222:2222:102
      fixed_v6_ips: []
      uuid: 5gbts-316-fronthaul_net-v6
    f1m:
      fixed_ips:
      - ip_address: 2a00:2222:2222:2222:2222:2222:2222:101
      fixed_v6_ips: []
      uuid: 5gbts-316-fronthaul_net-v6
    f1u:
      fixed_ips:
      - ip_address: 2a00:2222:2222:2222:2222:2222:2222:103
      fixed_v6_ips: []
      uuid: 5gbts-316-fronthaul_net-v6
    oam:
      fixed_ips:
      - ip_address: 2a00:8a02:60:1c:0:0:1:316
      uuid: 5gbts-oam_net-v6
    s1c:
      fixed_ips:
      - ip_address: 2a00:8a02:60:1c:0:0:2:316
      fixed_v6_ips: []
      uuid: 5gbts-oam_net-v6
    s1u:
      fixed_ips:
      - ip_address: 2a00:8a02:60:1c:0:0:3:316
      fixed_v6_ips: []
      uuid: 5gbts-oam_net-v6
    tracing:
      uuid: 5gbts-316-tracing_net-v6
    x2c:
      fixed_ips:
      - ip_address: 2a00:8a02:60:1c:0:0:2:316
      fixed_v6_ips: []
      uuid: 5gbts-oam_net-v6
    x2u:
      fixed_ips:
      - ip_address: 2a00:8a02:60:1c:0:0:3:316
      fixed_v6_ips: []
      uuid: 5gbts-oam_net-v6
  flavors:
    cpcl: gNB316_cpcl
    cpif: gNB316_cpif
    cpnb: gNB316_cpnb
    cpnrt: gNB316_cpnrt
    cpue: gNB316_cpue
    db: gNB316_db
    oam: gNB316_oam
    upue: gNB316_upue
    uvm: gNB316_uvm
  image: AirFrameVirtualized-7.3106.487
  internal_e1_networks:
    internal_e1:
    - 192.168.2.0/24
    - 192.168.2.2
    - 192.168.2.165
  internal_e1_provider_networks: fronthaul
  internal_provider_networks: fronthaul
  internal_segment_ids:
    internal: 35
    internal_e1: 37
    internal_srv: 36
  internal_subnets:
    internal:
    - 192.168.1.0/24
    - 192.168.1.2
    - 192.168.1.165
    internal_srv:
    - 192.168.3.0/24
    - 192.168.3.2
    - 192.168.3.165
  ntp_servers:
  - 2a00:8a02:60:1c:ffff:ffff:ffff:fffd
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  ssh_public_key: ssh-rsa 
  timezone: Europe/Warsaw
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - gecos: Robot user for test automation purposes
      home: /home/robot
      lock_passwd: false
      name: robot
      plain_text_passwd: rastre1
      primary-group: root
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: 'robot

        '
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
  uvm_image: AirFrameVirtualized-7.3106.487
  vnf_layout: basic
  vnf_name: 5gbts
