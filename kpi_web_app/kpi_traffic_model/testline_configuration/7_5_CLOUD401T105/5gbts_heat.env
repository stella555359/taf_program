parameters:
  image: TL105_Image
  ssh_public_key: "ssh-rsa "
  vnf_name: hgz-tl105
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.56.126.31 ]
  flavors:
    db: hgz-tl105_db
    sn: hgz-tl105_sn
    uvm: hgz-tl105_uvm
    oam: hgz-tl105_oam
    cpcl: hgz-tl105_cpcl
    cpif: hgz-tl105_cpif
    cpnrt: hgz-tl105_cpnrt
    cpnb: hgz-tl105_cpnb
    cpue: hgz-tl105_cpue
    upue: hgz-tl105_upue
  ntp_servers: 10.56.126.22
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Asia/Shanghai
  uvm_image: TL105_Image
  internal_segment_ids:
    internal: 1813
    internal_srv: 2213
    internal_e1: 1403
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: 78e6ec09-38cd-42d2-82e0-04f99d23753c
      fixed_ips: [ip_address: "10.57.170.5"]
    f1m:
      uuid: a9ab4b05-ac9f-455d-a418-fa876e6371b2
      fixed_ips: []
    f1c:
      uuid: a9ab4b05-ac9f-455d-a418-fa876e6371b2
      fixed_ips: []
    x2c:
      uuid: dcec1737-c667-4350-aafe-c06c69ec1506
      fixed_ips: [ip_address: "172.18.10.10"]
    s1c:
      uuid: dcec1737-c667-4350-aafe-c06c69ec1506
      fixed_ips: [ip_address: "172.18.10.10"]
    f1u:
      uuid: a9ab4b05-ac9f-455d-a418-fa876e6371b2
      fixed_ips: []
    x2u:
      uuid: dcec1737-c667-4350-aafe-c06c69ec1506
      fixed_ips: []
    s1u:
      uuid: dcec1737-c667-4350-aafe-c06c69ec1506
      fixed_ips: []
    tracing:
      uuid: 2b1b1e84-d549-4d81-bed7-2cc22260f2e8

  internal_provider_networks: physnet2-3
  internal_e1_provider_networks: physnet2-3
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'