resource_registry:
  5GBTS::Node::Oam: modules/5gbts_oam_node.yaml
  5GBTS::Node::Oam::In::Redundant: modules/5gbts_oam_node_in_redundant.yaml
  5GBTS::Node::Common: modules/5gbts_common_node.yaml
  5GBTS::Node::Common::Nplus: modules/5gbts_common_node_nplus.yaml
  5GBTS::Node::Common::Redundant: modules/5gbts_common_node_redundant.yaml
  5GBTS::Node::CPIF::Redundant: modules/5gbts_cpif_node_redundant.yaml
  5GBTS::Node::DB::Redundant: modules/5gbts_db_node_redundant.yaml
  5GBTS::Network::Setup: modules/5gbts_networks_setup.yaml
  5GBTS::Network::IntInterface: modules/5gbts_int_interface.yaml
  5GBTS::Network::ExtInterface: modules/5gbts_ext_interface.yaml
  5GBTS::Network::ExtInterface::Nplus: modules/5gbts_ext_interface_nplus.yaml
  5GBTS::Network::ExtInterface::Redundant: modules/5gbts_ext_interface_redundant.yaml
  5GBTS::Network::FixedIPInterface: modules/5gbts_fixed_ip_interface.yaml
  5GBTS::Networks::Common: modules/5gbts_common_interfaces.yaml
  5GBTS::Networks::Common::Nplus: modules/5gbts_common_interfaces_nplus.yaml
  5GBTS::Networks::Common::Redundant: modules/5gbts_common_interfaces_redundant.yaml
  5GBTS::Networks::OAM: modules/5gbts_oam_interfaces.yaml
  5GBTS::Networks::OAM::In::Redundant: modules/5gbts_oam_interfaces_in_redundant.yaml
  5GBTS::Network::loInform: modules/5gbts_lo_information.yaml
  5GBTS::Network::loInform::Nplus: modules/5gbts_lo_information_nplus.yaml
  5GBTS::Network::loInform::Redundant: modules/5gbts_lo_information_redundant.yaml
  RCP::Volume::Cinder: modules/5gbts_volume_cinder.yaml
  RCP::Volume::LVMLocal: modules/5gbts_volume_lvm_local.yaml
  RCP::Volume::LVMNFS: modules/5gbts_volume_lvm_nfs.yaml
  RCP::VolumeGroup::LVMLocal: modules/5gbts_volume_group_lvm_local.yaml
  RCP::VolumeGroup::LVMNFS: modules/5gbts_volume_group_lvm_nfs.yaml
parameters:
  image: 5.3135.553
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: 5gbts-realcore
  cluster_id: '01'
  vnfc_type_name_case: upper
  flavors:
    oam: 5gbts_oam
    cpcn: 5gbts_cpcn
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpnrt: 5gbts_cpnrt
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Europe/Paris
  oam_network: 5gbts-realcore-oam_net-v4
  oam_ip: 10.14.48.83
  oam_default_gw: 10.14.49.254
  ntp_servers: 10.14.35.126
  dns_forwarders: [ 10.14.35.126 ] 
  internal_network: 5gbts-realcore-internal_net-v4
  internal_srv_network: 5gbts-realcore-internal_srv_net-v4
  internal_e1_network: 5gbts-realcore-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
    internal_e1: [ 192.168.5.0/24, 192.168.5.2, 192.168.5.165 ]
  external_networks:
    extnet_a: 5gbts-realcore-extnet-a_net-v6
    extnet_b: 5gbts-realcore-extnet-b_net-v6
  ext_port:
    f1om_sid_a: 108
    fronthaul_cpif_sid_a: 118
    fronthaul_upue_sid_a: 118
    backhaul_cpif_sid_a: 402
    backhaul_upue_sid_a: 402
    f1om_sid_b: 109
    fronthaul_cpif_sid_b: 119
    fronthaul_upue_sid_b: 119
    backhaul_cpif_sid_b: 403
    backhaul_upue_sid_b: 403
  
    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '3000::10:83:817:10/128' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '3000::10:83:817:11/128' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '3000::10:83:817:20/128' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '3000::10:83:817:21/128' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '3000::10:83:817:1/128' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '3000::10:83:817:2/128' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [ '3000::10:83:817:30/128' ]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [ '3000::10:83:817:40/128' ]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '3000::10:83:817:50/128' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '3000::10:83:108:2/128' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '3000::10:83:118:2/128' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [ '3000::10:83:118:3/128' ]
    backhaul_role_cpif: 'S1-C,X2-C'
    backhaul_ip_cpif: [ 'fd6b:b951:3aa5:613:1:83:4002:2/128' ]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [ 'fd6b:b951:3aa5:613:1:83:4002:3/128' ]
    
    f1om_ip_oam_a: [ 'fd00::10:83:108:2/112' ]
    fronthaul_ip_cpif_a: [ 'fd00::10:83:118:2/112' ]
    fronthaul_ip_upue_a: [ 'fd00::10:83:118:3/112' ]
    backhaul_ip_cpif_a: [ 'fd00::10:83:402:2/112' ]
    backhaul_ip_upue_a: [ 'fd00::10:83:402:3/112' ]
    
    f1om_ip_oam_b: [ 'fd00::10:83:109:2/112' ]
    fronthaul_ip_cpif_b: [ 'fd00::10:83:119:2/112' ]
    fronthaul_ip_upue_b: [ 'fd00::10:83:119:3/112' ]
    backhaul_ip_cpif_b: [ 'fd00::10:83:403:2/112' ]
    backhaul_ip_upue_b: [ 'fd00::10:83:403:3/112' ]

  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1400
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1400
  ext_pmtu: 1500
  availability_zone: cpu.pin_isolate
  oam_security_group: 
  number_of_upue_nodes: 1
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
