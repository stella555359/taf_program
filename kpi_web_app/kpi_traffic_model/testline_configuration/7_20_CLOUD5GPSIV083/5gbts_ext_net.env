parameters:
  network_opts:
    vnf_name: 5gbts-realcore
    number_of_networks: 2

    # external networks based on flat provider network (sriov)
    networks:  

      - name: extnet-a
        cidr: 3000::110:0/110
        gateway: null
        start: 3000::110:2
        end: 3000::110:22
        net_type: flat
        ip_ver: 6
        provider: sriov-a
        tenant_id: d950ad7a74fd41be8080029fe7788488

      - name: extnet-b
        cidr: 3000::110:0/110
        gateway: null
        start: 3000::113:2
        end: 3000::113:22
        net_type: flat
        ip_ver: 6
        provider: sriov-b
        tenant_id: d950ad7a74fd41be8080029fe7788488
