parameters:
  network_opts:
    vnf_name: CV63-5gbts
    dns_forwarders: 10.10.10.10
    number_of_networks: 4

    # all external networks
    networks:

      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.48.63
        end: 10.14.48.63
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.110
        end: 192.168.2.120
        net_type: vlan
        sid: 1111
        ip_ver: 4
        provider: physnet3

      - name: backhaul
        cidr: 10.5.118.136/29
        gateway: 10.5.118.142
        start: 10.5.118.137
        end: 10.5.118.141
        net_type: vlan
        sid: 4002
        ip_ver: 4
        provider: physnet1

      - name: tracing
        cidr: 192.168.5.0/24
        gateway: 192.168.5.1
        start: 192.168.5.100
        end: 192.168.5.200
        net_type: vlan
        sid: 2307
        ip_ver: 4
        provider: physnet1