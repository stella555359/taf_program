parameters:
  network_opts:
    vnf_name: tl18-5gbts
    dns_forwarders: 10.171.0.1
    number_of_networks: 3

    # all external networks
    networks:

      - name: oam
        cidr: 10.41.169.0/27
        gateway: 10.41.169.1
        start: 10.41.169.15
        end: 10.41.169.17
        net_type: vlan
        sid: 100
        ip_ver: 4
        provider: external

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 1100
        ip_ver: 4
        provider: internal

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3000
        ip_ver: 4
        provider: external

