parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: example-5gbts
    dns_forwarders: 10.10.10.10
    networks:
      - name: oam
        cidr: 10.110.63.0/25
        gateway: 10.110.63.1
        start: 10.110.63.2
        end: 10.110.63.4
        net_type: vlan
        sid: 0
        ip_ver: 4
        provider: physnet-0
      - name: fronthaul
        cidr: 10.110.63.128/25
        gateway: 10.110.63.129
        start: 10.110.63.100
        end: 10.110.63.200
        ip_ver: 4
        cidr_v6: fc00::172:16:5:0/112
        gateway_v6: fc00::172:16:5:1
        start_v6:  fc00::172:16:5:100
        end_v6:  fc00::172:16:5:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 0
        provider: physnet-1
      - name: backhaul
        cidr: 10.110.64.128/25
        gateway: 10.110.64.129
        start: 10.110.64.100
        end: 10.110.64.200
        ip_ver: 4
        cidr_v6: fc00::172:16:2:0/112
        gateway_v6: fc00::172:16:2:1
        start_v6: fc00::172:16:2:100
        end_v6: fc00::172:16:2:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 0
        provider: physnet-0
      - name: tracing
        cidr: 10.110.192.0/25
        gateway: 10.110.192.1
        start: 10.110.192.100
        end: 10.110.192.200
        net_type: vlan
        sid: 0
        ip_ver: 4
        provider: physnet-0

