parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: 5gbts-191
    dns_forwarders: 10.83.200.2
    networks:
      - name: fronthaul
        cidr: 172.16.5.0/24
#        gateway: 172.16.5.1
        start: 172.16.5.100
        end: 172.16.5.200
        ip_ver: 4
        net_type: vlan
        sid: 1691
        provider: providerFronthaul
      - name: backhaul
        cidr: 172.16.2.0/24
#        gateway: 172.16.2.1
        start: 172.16.2.100
        end: 172.16.2.200
        ip_ver: 4
        net_type: vlan
        sid: 2691
        provider: providerBackhaul
