parameters:
  network_opts:
    vnf_name: tl803-5gbts
    networks:
      - name: oam
        cidr: 192.168.255.0/24
        gateway: 192.168.255.200
        start: 192.168.255.1
        end: 192.168.255.100
        net_type: vlan
        sid: 1693
        ip_ver: 4
        provider: provider0

      - name: fronthaul
        cidr: 10.0.3.0/24
        gateway: 10.0.3.200
        start: 10.0.3.1
        end: 10.0.3.100
        ip_ver: 4
        net_type: vlan
        sid: 1658
        provider: provider0

      - name: backhaul
        cidr: 10.0.1.0/24
        gateway: 10.0.1.200
        start: 10.0.1.1
        end: 10.0.1.100
        ip_ver: 4
        net_type: vlan
        sid: 1690
        provider: provider0

      - name: tracing
        cidr: 10.0.4.0/24
        gateway: 10.0.4.1
        start: 10.0.4.100
        end: 10.0.4.200
        net_type: vlan
        sid: 1660
        ip_ver: 4
        provider: provider0