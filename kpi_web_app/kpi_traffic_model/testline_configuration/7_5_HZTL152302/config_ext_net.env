parameters:
  network_opts:
    vnf_name: tl401
    dns_forwarders: 10.10.10.10
    networks:
      - name: fronthaul
        cidr: 172.16.1.0/24
        gateway: 172.16.1.1
        start: 172.16.1.100
        end: 172.16.1.200
        net_type: vlan
        sid: 1662
        ip_ver: 4
        provider: provider1
      - name: backhaul
        cidr: 172.16.2.0/24
        gateway: 172.16.2.1
        start: 172.16.2.100
        end: 172.16.2.200
        net_type: vlan
        sid: 1663
        ip_ver: 4
        provider: provider0
      - name: tracing
        cidr: 172.16.4.0/24
        gateway: 172.16.4.1
        start: 172.16.4.100
        end: 172.16.4.200
        net_type: vlan
        sid: 1664
        ip_ver: 4
        provider: provider0

