parameters:
  image: 
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: tl401
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: tl401_db
    sn: tl401_sn
    uvm: tl401_uvm
    oam: tl401_oam
    cpcl: tl401_cpcl
    cpif: tl401_cpif
    cpnrt: tl401_cpnrt
    cpnb: tl401_cpnb
    cpue: tl401_cpue
    upue: tl401_upue
  ntp_servers: 10.56.126.22
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Asia/Shanghai
  uvm_image: 

  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
