    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: aa7460d1-9aed-42e3-a009-b3580c13f450
      fixed_ips: [ip_address: 10.57.212.52]
    f1m:
      uuid: 
      fixed_ips: [ip_address: 172.16.1.127]
    f1c:
      uuid: 
      fixed_ips: [ip_address: 172.16.1.122]
    x2c:
      uuid: 
      fixed_ips: [ip_address: 172.16.2.124]
    s1c:
      uuid: 
      fixed_ips: [ip_address: 172.16.2.124]
    f1u:
      uuid: 
    s1u:
      uuid: 
    x2u:
      uuid: 
    tracing:
      uuid: 

  internal_provider_networks: provider1
  internal_e1_provider_networks: provider1
  vnf_layout: basic
  config_external_ip: enabled
