parameters:
  image: AirFrameVirtualized-4.2113.529-ECE+180917.346 
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: 5gbts
  cluster_id: 1
  flavors:
    oam: 5gbts_oam
    cpcn: 5gbts_cpcn
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Asia/Kolkata 
  oam_network: d3549cbb-1120-406f-bfe2-f58185be697f 
  oam_ip: 10.43.205.242 
  ntp_servers: 10.171.8.4 
  dns_forwarders: [ 10.171.0.1 ]
  password:
    _nokadmin:         $5$rounds=10000$XNL0TTul$apxMlCYaiHNTIe5jeYxceZrtLiLCYEe/LMpbGTkG/a8 
    _nokfsoperator:    $5$rounds=10000$XNL0TTul$apxMlCYaiHNTIe5jeYxceZrtLiLCYEe/LMpbGTkG/a8 
    root:              $5$rounds=10000$XNL0TTul$apxMlCYaiHNTIe5jeYxceZrtLiLCYEe/LMpbGTkG/a8 
  internal_networks:
    internal: [ 169.254.0.0/19, 169.254.0.2, 169.254.0.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.200 ]
  external_networks:
    backhaul: bc16341a-59d1-4fc7-b577-b26d3861e71a 
    fronthaul: 8462fe65-8c22-48f7-b23b-85f60cdf4519 
  internal_provider_networks: internal 
  vnfc_layout: 5G18A
  number_of_upue_nodes: 1 
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  number_of_db_nodes: 1
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
