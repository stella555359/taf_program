parameters:
  network_opts:
    vnf_name: 5gbts
    dns_forwarders: 192.168.255.241
    networks:
      - name: oam
        cidr: 192.168.255.0/24
        gateway: 192.168.255.254
        start: 192.168.255.100
        end: 192.168.255.110
        net_type: vlan
        sid: 1200
        ip_ver: 4
        provider: physnet1
      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 1100
        ip_ver: 4
        provider: physnet3
      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3000
        ip_ver: 4
        provider: physnet1
      - name: tracing
        cidr: 192.168.5.0/24
        gateway: 192.168.5.1
        start: 192.168.5.100
        end: 192.168.5.200
        net_type: vlan
        sid: 4000
        ip_ver: 4
        provider: physnet1

