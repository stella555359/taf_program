parameters:
  image: 10.1100.543
  ssh_public_key: "ssh-rsa "
  vnf_name: hgz-tl111
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  network-interface-enable: true
  flavors:
    db: hgz-tl111_db
    uvm: hgz-tl111_uvm
    oam: hgz-tl111_oam
    cpcl: hgz-tl111_cpcl
    cpif: hgz-tl111_cpif
    cpnrt: hgz-tl111_cpnrt
    cpnb: hgz-tl111_cpnb
    cpue: hgz-tl111_cpue
    upue: hgz-tl111_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova-tl111
    oam_000: nova-tl111
    oam_001: nova-tl111
    cpcl_000: nova-tl111
    cpcl_001: nova-tl111
    cpnb_000: nova-tl111
    cpnb_001: nova-tl111
    cpif_000: nova-tl111
    cpif_001: nova-tl111
    cpnrt_000: nova-tl111
    cpnrt_001: nova-tl111
    db_000: nova-tl111
    db_001: nova-tl111
    db_002: nova-tl111
    uvm: nova
    cpues:
      default: nova-tl111
      availability_zone_list:
        - nova-tl111
    upues:
      default: nova-tl111
      availability_zone_list:
        - nova-tl111
  number_of_cpue_nodes: 2
  number_of_upue_nodes: 2
  number_of_uvm_nodes: 0
  cleartextpassword:
    georesiliency: 'VpOn9JSX6r%G#T'
    wsuser: 'A0zY~rP#8Mx@'
  password:
    _nokfsoperator: '!'
    root: '!'
    georesiliency: '$5$rounds=10000$YLkADD9q$/7cX20b5eNgcjvnN1kteCmZR4siF6oQfW1/9hzh4YZ7'
    wsuser: '$5$rounds=10000$6Kj3xARF$6D8XNkLOFxc8yswG4hhvCXyCdHau5WY6yxH/ZxRrle8'
  timezone: Asia/Shanghai
  uvm_image: 10.1100.543
  internal_segment_ids:
    internal: 1202
    internal_srv: 1203
    internal_e1: 1204
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: OAM
      fixed_ips: [ip_address: 10.57.169.2]
      fixed_ips_0: [ip_address: 10.57.169.8]
      fixed_ips_1: [ip_address: 10.57.169.9]
    f1c:
      uuid: hgz-tl111-fronthaul_net-v4
      fixed_ips: [ip_address: 10.57.169.131]
      fixed_ips_0: [ip_address: 10.57.169.130]
      fixed_ips_1: [ip_address: 10.57.169.132]
      fixed_v6_ips: []
    x2c:
      uuid: hgz-tl111-backhaul_net-v4
      fixed_ips: [ip_address: 10.57.169.138]
      fixed_ips_0: [ip_address: 10.57.169.139]
      fixed_ips_1: [ip_address: 10.57.169.140]
      fixed_v6_ips: []
    f1u:
      uuid: hgz-tl111-fronthaul_net-v4
      fixed_ips: [ip_address: 10.57.169.133, ip_address: 10.57.169.134]
      fixed_v6_ips: []
    x2u:
      uuid: hgz-tl111-backhaul_net-v4
      fixed_ips: [ip_address: 10.57.169.141, ip_address: 10.57.169.142]
      fixed_v6_ips: []
    s1u:
      uuid: hgz-tl111-backhaul_net-v4
      fixed_ips: [ip_address: 10.57.169.141, ip_address: 10.57.169.142]
      fixed_v6_ips: []
    tracing:
      uuid: hgz-tl111-tracing_net-v4

  internal_provider_networks: provider1
  internal_e1_provider_networks: provider1
  vnf_layout: redundant
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: |
        { "nonRootFullBashEnabled": true }
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
