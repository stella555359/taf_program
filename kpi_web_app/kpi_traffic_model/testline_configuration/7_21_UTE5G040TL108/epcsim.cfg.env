#Parameter should be match the value in ./edaemon --port <DAEMON_PORT>
set DAEMON_IP="172.30.1.1" 
set DAEMON_PORT=10000

# ASI
set ASI88="172.30.1.10"

set S1_ADDR="172.30.1.1:36412"
set S1U_ADDR="172.30.1.1:2152"
set S11_ADDR="172.30.1.1:2153"

set MME1_S1_ADDR="172.30.1.1"
#PGW addresses and UE IPs should belong to the same subnet

## PGW FOR GENTEK 
set PGW_ADDR_1="27.168.1.200/24"


set_enb id=1 plmn=440:51 s1=$ASI88 enb_id_macro=0x09CAC daemon=$DAEMON_IP:$DAEMON_PORT


#configuring EPC
set_mme id=1 ip=$DAEMON_IP:$DAEMON_PORT s1=$MME1_S1_ADDR:36412 mmegi=1 mmec=3 
mme_param id=1 t3412=11160

set_sgw id=1 ip=:$DAEMON_PORT s1u=$S1U_ADDR s11=$S11_ADDR

set_pgw id=1 ip=:$DAEMON_PORT apn=www.nj.com devtype=tun devname=tunPGW1 addr=$PGW_ADDR_1 #type=simulated


#Configuring UEs

# NH AUTH profile 1



#### GEMTEK UE ########
set_ue external id=1 sec_key=11111111111111111111111111111111 opc_key=11111111111111111111111111111111 imsi=440:51:0100000054 eia=aes eea=aes

set_bearer id=2 ue=1 pdn=1 default=on qci=9 ip=27.168.1.10 nat_ip=27.168.1.200


#Turning on the information only about errors--for high perfomance
debug_log level=3 dir=logs
set_log log_to_file=on
pgw_lmts_param bearer_activation_by_trf=on

ue_mme_param id=1 eea=null

#trace protocol=nas mme=1 on
#trace protocol=all action=on sgw=1 mme=1
#trace protocol=nas uec=1 action=on
#trace protocol=rrc uec=1 action=on
#trace protocol=all uec=1 mme=1 
#trace protocol=nas mme=1 on
#trace protocol=s1 mme=1 on

cfg_end

