parameters:
  network_opts:
    vnf_name: example-5gbts
    dns_forwarders: 135.117.48.1
    number_of_networks: 3

    # all external networks
    networks:

      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.48.196
        end: 10.14.48.196
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1

      - name: fronthaul
        cidr: 192.168.2.0/23
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 1100
        ip_ver: 4
        provider: physnet3

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3001
        ip_ver: 4
        provider: physnet1

